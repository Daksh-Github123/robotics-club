---
/**
 * Shown until a project has a real photo. Deliberately plain so nobody
 * mistakes it for the real thing. Add `cover:` to the project file to replace it.
 */
interface Props {
  seed: string;
  label?: string;
}
const { label = '' } = Astro.props;
---

<div class="ph" role="img" aria-label={`Photo coming soon${label ? `: ${label}` : ''}`}>
  <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M4 8h3l2-3h6l2 3h3v11H4z"></path>
    <circle cx="12" cy="13" r="3.5"></circle>
  </svg>
  <span class="ph-t">Photo coming soon</span>
  {label && <span class="ph-l">{label}</span>}
</div>

<style>
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    padding: 16px;
    text-align: center;
    color: var(--faint);
    background:
      repeating-linear-gradient(-45deg, transparent 0 14px, rgba(26, 22, 17, 0.035) 14px 15px),
      var(--surface-2);
  }
  .ph-t {
    font-weight: 700;
    font-size: 14px;
  }
  .ph-l {
    font-size: 13px;
  }
</style>
