---
/**
 * Generated "blueprint" art used until a project has a real photo.
 * The same seed always produces the same picture.
 */
interface Props {
  seed: string;
  label?: string;
}
const { seed, label = 'PHOTO COMING SOON' } = Astro.props;

let h = 7;
for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const variant = h % 4;
const angle = h % 360;
const warm = h % 2 === 0;
const id = `ph${h.toString(36)}`;
const a = warm ? '#FF7A1A' : '#2F7BFF';
const b = warm ? '#2F7BFF' : '#FF7A1A';

function gear(cx: number, cy: number, ro: number, ri: number, n: number) {
  let d = '';
  const s = (Math.PI * 2) / n;
  for (let i = 0; i < n; i++) {
    const t0 = i * s;
    const pts: [number, number][] = [
      [ri, t0],
      [ro, t0 + s * 0.16],
      [ro, t0 + s * 0.44],
      [ri, t0 + s * 0.6],
    ];
    pts.forEach(([r, t], j) => {
      d += `${i === 0 && j === 0 ? 'M' : 'L'}${(cx + Math.cos(t) * r).toFixed(1)} ${(cy + Math.sin(t) * r).toFixed(1)} `;
    });
  }
  return d + 'Z';
}
const pins = [0, 1, 2, 3].map((i) => 112 + i * 25);
---

<div class="ph" aria-hidden="true">
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id={`${id}g`} gradientTransform={`rotate(${angle} .5 .5)`}>
        <stop offset="0" stop-color={a} stop-opacity=".5"></stop>
        <stop offset="1" stop-color={b} stop-opacity=".28"></stop>
      </linearGradient>
      <radialGradient id={`${id}r`} cx=".5" cy=".5" r=".6">
        <stop offset="0" stop-color="#000" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#000" stop-opacity=".55"></stop>
      </radialGradient>
      <pattern id={`${id}p`} width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" fill="none" stroke="#fff" stroke-opacity=".07"></path>
      </pattern>
    </defs>
    <rect width="400" height="300" fill="#0E1118"></rect>
    <rect width="400" height="300" fill={`url(#${id}g)`}></rect>
    <rect width="400" height="300" fill={`url(#${id}p)`}></rect>
    <g fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      {
        variant === 0 && (
          <g stroke-opacity=".6">
            <path d={gear(185, 155, 72, 58, 12)} />
            <circle cx="185" cy="155" r="20" />
            <path d={gear(278, 92, 42, 32, 8)} stroke-opacity=".4" />
          </g>
        )
      }
      {
        variant === 1 && (
          <g stroke-opacity=".6">
            <path d="M110 238h100" />
            <path d="M160 238v-38l52-74 76 22" />
            <circle cx="160" cy="200" r="11" />
            <circle cx="212" cy="126" r="11" />
            <path d="M288 148l22-16M288 148l22 16" />
          </g>
        )
      }
      {
        variant === 2 && (
          <g stroke-opacity=".6">
            <rect x="118" y="116" width="164" height="72" rx="14" />
            <circle cx="152" cy="202" r="25" />
            <circle cx="248" cy="202" r="25" />
            <path d="M200 116V86" />
            <circle cx="200" cy="76" r="9" />
            <circle cx="166" cy="148" r="7" />
            <circle cx="234" cy="148" r="7" />
          </g>
        )
      }
      {
        variant === 3 && (
          <g stroke-opacity=".6">
            <rect x="150" y="100" width="100" height="100" rx="10" />
            <rect x="176" y="126" width="48" height="48" />
            {pins.map((p) => (
              <path d={`M${p + 38} 100v-18M${p + 38} 200v18M150 ${p}h-18M250 ${p}h18`} />
            ))}
          </g>
        )
      }
    </g>
    <rect width="400" height="300" fill={`url(#${id}r)`}></rect>
    <text
      x="20"
      y="284"
      font-family="JetBrains Mono, monospace"
      font-size="10"
      fill="#fff"
      fill-opacity=".55"
      letter-spacing="2">{label}</text
    >
  </svg>
</div>

<style>
  .ph {
    position: absolute;
    inset: 0;
    background: #0e1118;
  }
  .ph svg {
    width: 100%;
    height: 100%;
  }
</style>
