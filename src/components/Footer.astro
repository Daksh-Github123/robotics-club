---
import { site } from '../site.config';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const explore = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/team/', label: 'Team' },
  { href: '/competitions/', label: 'Competitions' },
  { href: '/join/', label: 'Join / FAQ' },
  ...(site.features.showSponsors ? [{ href: '/sponsors/', label: 'Sponsors' }] : []),
];
const socials = [
  { href: site.socials.instagram, label: 'Instagram', icon: 'instagram' },
  { href: site.socials.youtube, label: 'YouTube', icon: 'youtube' },
  { href: site.socials.email ? `mailto:${site.socials.email}` : '', label: 'Email', icon: 'mail' },
  { href: site.repoUrl, label: 'Source on GitHub', icon: 'github' },
].filter((s) => s.href);
---

<footer class="footer">
  <div class="container">
    <a href="/join/" class="f-big" data-reveal>
      <span>Let's build</span>
      <span class="grad">something.</span>
      <span class="f-arrow"><Icon name="arrow" size={44} /></span>
    </a>

    <div class="f-grid">
      <div class="f-brand">
        <a href="/" class="f-logo">
          <span class="f-mark">{site.shortName}</span>
          {site.name}
        </a>
        <p class="muted">{site.school} · est. {site.founded}</p>
      </div>
      <nav aria-label="Footer">
        <h4>Explore</h4>
        <ul>{explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div>
        <h4>Meetings</h4>
        <ul>
          <li class="f-row"><Icon name="clock" size={16} />{site.meeting.when}</li>
          <li class="f-row"><Icon name="pin" size={16} />{site.meeting.where}</li>
        </ul>
      </div>
      <div>
        <h4>Elsewhere</h4>
        <ul>
          {
            socials.map((s) => (
              <li>
                <a class="f-row" href={s.href} target="_blank" rel="noopener">
                  <Icon name={s.icon} size={16} />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="f-bottom mono">
      <span>© {year} {site.name}</span>
      <span>Built by club members ✦ Powered by caffeine & solder</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(7, 8, 11, 0.4), var(--bg) 40%);
    padding-top: clamp(72px, 10vw, 130px);
    overflow: hidden;
  }
  .footer::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: min(900px, 90vw);
    height: 1px;
    translate: -50% 0;
    background: var(--grad);
    box-shadow: 0 0 40px 2px rgba(255, 122, 26, 0.5);
  }
  .f-big {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.3em;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(44px, 9vw, 132px);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .f-arrow {
    display: grid;
    place-items: center;
    width: clamp(56px, 7vw, 96px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    transition:
      background 0.3s,
      transform 0.5s var(--ease-out),
      border-color 0.3s;
  }
  .f-big:hover .f-arrow {
    background: var(--orange);
    border-color: var(--orange);
    color: #160800;
    transform: rotate(-45deg);
  }
  .f-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1fr;
    gap: 40px;
    margin-top: clamp(56px, 8vw, 100px);
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .f-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .f-mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    clip-path: polygon(25% 4%, 75% 4%, 100% 50%, 75% 96%, 25% 96%, 0 50%);
    background: var(--grad-solid);
    font-size: 11px;
    font-weight: 900;
  }
  h4 {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 16px;
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 15px;
  }
  ul a {
    color: var(--muted);
    transition: color 0.2s;
  }
  ul a:hover {
    color: var(--text);
  }
  .f-row {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
  }
  .f-row :global(svg) {
    flex-shrink: 0;
    color: var(--orange-glow);
  }
  .f-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 56px;
    padding-block: 28px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.04em;
  }
  @media (max-width: 860px) {
    .f-grid {
      grid-template-columns: 1fr 1fr;
    }
    .f-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .f-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
