---
import { site } from '../site.config';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const explore = [
  { href: '/', label: 'Home' },
  { href: '/why-join/', label: 'Why join' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/join/', label: 'Join / FAQ' },
  ...(site.features.showSponsors ? [{ href: '/sponsors/', label: 'Sponsors' }] : []),
];
const socials = [
  { href: site.socials.instagram, label: 'Instagram', icon: 'instagram' },
  { href: site.socials.youtube, label: 'YouTube', icon: 'youtube' },
  { href: site.socials.email ? `mailto:${site.socials.email}` : '', label: 'Email', icon: 'mail' },
  { href: site.repoUrl, label: 'Source on GitHub', icon: 'github' },
].filter((s) => s.href);
---

<footer class="footer">
  <div class="container">
    <a href="/join/" class="f-big">Let's build something.</a>

    <div class="f-grid">
      <div class="f-brand">
        <a href="/" class="f-logo">
          <span class="f-mark">{site.shortName}</span>
          {site.name}
        </a>
        <p class="muted">{site.school}'s student-led tech club</p>
      </div>
      <nav aria-label="Footer">
        <h4>Explore</h4>
        <ul>{explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div>
        <h4>Meetings</h4>
        <ul>
          <li class="f-row"><Icon name="clock" size={16} />{site.meeting.when}</li>
          <li class="f-row"><Icon name="pin" size={16} />{site.meeting.where}</li>
        </ul>
      </div>
      <div>
        <h4>Elsewhere</h4>
        <ul>
          {
            socials.map((s) => (
              <li>
                <a class="f-row" href={s.href} target="_blank" rel="noopener">
                  <Icon name={s.icon} size={16} />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="f-bottom">
      <span>© {year} {site.name}</span>
      <span>Built and maintained by club members</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--navy);
    color: #fff;
    padding-top: clamp(64px, 8vw, 110px);
    overflow: hidden;
    --muted: #c3cae0;
    --faint: #98a2c2;
  }
  .f-big {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: clamp(32px, 5vw, 68px);
    line-height: 1;
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.16em;
    transition: color 0.2s;
  }
  .f-big:hover {
    color: var(--orange);
  }
  .f-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1fr;
    gap: 40px;
    margin-top: clamp(56px, 8vw, 100px);
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .f-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    margin-bottom: 10px;
  }
  .f-mark {
    width: 40px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 3px;
    background: #fff;
    box-shadow: inset 0 -5px 0 var(--orange);
    color: var(--navy);
    font-size: 12px;
    font-weight: 800;
    padding-bottom: 4px;
  }
  h4 {
    font-family: var(--font-body);
    font-stretch: 100%;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
    color: #fff;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 15px;
  }
  ul a {
    color: var(--muted);
    transition: color 0.2s;
  }
  ul a:hover {
    color: #fff;
  }
  .f-row {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
  }
  .f-row :global(svg) {
    flex-shrink: 0;
    color: var(--orange);
  }
  .f-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 56px;
    padding-block: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 14px;
    color: var(--faint);
  }
  @media (max-width: 860px) {
    .f-grid {
      grid-template-columns: 1fr 1fr;
    }
    .f-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .f-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
