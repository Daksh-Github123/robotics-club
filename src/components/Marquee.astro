---
/** Infinite scrolling ticker of big words. Skews with scroll speed. */
interface Props {
  words: string[];
  reverse?: boolean;
}
const { words, reverse = false } = Astro.props;
---

<div class:list={['marquee', { reverse }]} aria-hidden="true" data-velocity-skew>
  <div class="marquee-track">
    {
      [0, 1].map(() => (
        <div class="marquee-group">
          {words.map((w, i) => (
            <span class:list={['mq-word', { 'mq-fill': i % 2 === 1 }]}>
              {w}
              <i>•</i>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 10px;
    user-select: none;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }
  .reverse .marquee-track {
    animation-direction: reverse;
  }
  .marquee-group {
    display: flex;
    flex-shrink: 0;
  }
  .mq-word {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding-right: 0.5em;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 8vw, 120px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1.5px #3a4356;
    white-space: nowrap;
  }
  .mq-fill {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 0;
  }
  .mq-word i {
    font-style: normal;
    font-size: 0.4em;
    color: var(--orange);
    -webkit-text-stroke: 0;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
