---
/** The practical "how to join" box. Used on the homepage and the Why Join page. */
import Icon from './Icon.astro';
import { site } from '../site.config';
import SignupStatus from './SignupStatus.astro';

interface Props {
  title?: string;
}
const { title = 'Joining' } = Astro.props;
---

<div class="join">
  <div>
    <h2 class="h2">{title}</h2>
    <p class="lede">Sign up when the school opens Beyond Academics (BA) sign-ups. Spots are first come, first served.</p>
    <SignupStatus class="join-status" />
    <div class="join-cta">
      <a href="/join/" class="btn btn-primary">Full details and FAQ <Icon name="arrow" size={18} /></a>
      <a href="/join/#contacts" class="btn btn-ghost">Ask a question</a>
    </div>
  </div>
  <dl class="facts">
    <div><dt>Sign-ups</dt><dd>BA sign-ups, first come, first served</dd></div>
    <div><dt>When</dt><dd>{site.meeting.when}</dd></div>
    <div><dt>Where</dt><dd>{site.meeting.where}</dd></div>
    <div>
      <dt>Cost</dt>
      <dd>Robotics members buy the parts for their own project, after planning exactly what they need. Software projects usually cost nothing.</dd>
    </div>
    <div><dt>Bring</dt><dd>A working laptop to every class</dd></div>
    <div><dt>Experience</dt><dd>None needed, just a willingness to learn</dd></div>
  </dl>
</div>

<style>
  .join {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    padding: clamp(24px, 4vw, 44px);
    background: var(--surface);
    border: 1.5px solid var(--text);
    border-radius: var(--radius-lg);
  }
  .lede {
    margin-top: 10px;
  }
  :global(.join-status) {
    margin-top: 16px;
  }
  .join-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .facts {
    margin: 0;
    display: grid;
  }
  .facts div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
  }
  .facts div:last-child {
    border-bottom: 0;
  }
  .facts dt {
    font-weight: 700;
  }
  .facts dd {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .join {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .facts div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
