---
/**
 * The practical "how to join" block: a full-width orange plane.
 * Place it directly in the page, not inside a .container.
 */
import { site } from '../site.config';
import SignupStatus from './SignupStatus.astro';

interface Props {
  title?: string;
}
const { title = 'Joining' } = Astro.props;
---

<section class="join" id="join">
  <div class="container join-grid">
  <div>
    <h2 class="h2">{title}</h2>
    <p class="lede">Sign up when the school opens Beyond Academics (BA) sign-ups. Spots are first come, first served.</p>
    <SignupStatus class="join-status" />
    <div class="join-cta">
      <a href="/join/" class="btn btn-dark">Full details and FAQ</a>
      <a href="/join/#contacts" class="btn btn-ghost">Ask a question</a>
    </div>
  </div>
  <dl class="facts">
    <div><dt>Sign-ups</dt><dd>BA sign-ups, first come, first served</dd></div>
    <div><dt>When</dt><dd>{site.meeting.when}</dd></div>
    <div><dt>Where</dt><dd>{site.meeting.where}</dd></div>
    <div>
      <dt>Cost</dt>
      <dd>Robotics members buy the parts for their own project, after planning exactly what they need. Software projects usually cost nothing.</dd>
    </div>
    <div><dt>Bring</dt><dd>A working laptop to every class</dd></div>
    <div><dt>Experience</dt><dd>None needed, just a willingness to learn</dd></div>
  </dl>
  </div>
</section>

<style>
  .join {
    background: var(--orange);
    color: var(--navy);
    padding-block: clamp(56px, 8vw, 104px);
  }
  .join-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 72px);
  }
  .h2 {
    font-size: clamp(34px, 4.4vw, 58px);
  }
  .lede {
    margin-top: 14px;
    color: var(--navy);
  }
  :global(.join-status) {
    margin-top: 18px;
    background: #fff !important;
  }
  .btn-dark {
    background: var(--navy);
    color: #fff;
    border: 2px solid var(--navy);
  }
  .btn-dark:hover {
    background: #fff;
    color: var(--navy);
    border-color: #fff;
  }
  .btn-ghost {
    border-color: var(--navy);
    color: var(--navy);
  }
  .btn-ghost:hover {
    background: var(--navy);
    color: #fff;
  }
  .join-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .facts {
    margin: 0;
    display: grid;
  }
  .facts div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(23, 35, 71, 0.22);
  }
  .facts div:last-child {
    border-bottom: 0;
  }
  .facts dt {
    font-weight: 700;
  }
  .facts dd {
    margin: 0;
  }
  @media (max-width: 900px) {
    .join-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .facts div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
