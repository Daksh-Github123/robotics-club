---
/**
 * Homepage project row: the highlighted projects (featured: true) followed by a
 * "See every project" card. A plain row on desktop, swipeable on phones.
 */
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import Icon from './Icon.astro';
import { yearLabel, teamNames } from '../lib/meta';

interface Props {
  projects: CollectionEntry<'projects'>[];
  total: number;
}
const { projects, total } = Astro.props;
---

<ul class="hg" aria-label="Highlighted projects">
  {
    projects.map((p) => {
      // Software projects link straight to the live site
      const live = p.data.stream === 'software' ? p.data.links[0] : undefined;
      return (
        <li class="hg-slot">
          <article class={`hg-card hg-${p.data.stream}`}>
            <div class="hg-media">
              <ProjectMedia project={p} />
            </div>
            <div class="hg-body">
              <span class={`stream stream-${p.data.stream}`}>{p.data.stream === 'software' ? 'Software' : 'Robotics'}</span>
              <p class="hg-meta">
                <span>{teamNames(p.data.team)}</span>
                <span>{yearLabel(p.data.academicYear)}</span>
              </p>
              <h3>
                <a class="hg-link" href={`/projects/${p.id}/`}>
                  {p.data.title}
                </a>
              </h3>
              <p class="hg-outcome">{p.data.outcome ?? p.data.tagline}</p>
              {live && (
                <a class="hg-live" href={live.url} target="_blank" rel="noopener">
                  {live.label} <Icon name="external" size={14} />
                </a>
              )}
            </div>
          </article>
        </li>
      );
    })
  }
  <li class="hg-slot hg-slot-more">
    <a class="hg-more" href="/projects/">
      <span class="hg-more-n">{total}</span>
      <span>projects so far. See every one, with the parts used and how each works.</span>
      <span class="hg-more-go">All projects</span>
    </a>
  </li>
</ul>

<style>
  .hg {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr) 0.75fr;
    gap: 16px;
  }
  /* Tiles: a stream-coloured bar on top, hard edges, no shadow */
  .hg-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 6px solid var(--orange);
    transition: border-color 0.2s;
  }
  .hg-robotics {
    border-top-color: var(--blue);
  }
  .hg-card:hover {
    border-color: var(--navy);
    border-top-color: var(--navy);
  }
  .hg-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
  }
  .hg-body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 22px;
  }
  .hg-body .stream {
    justify-self: start;
  }
  .hg-card {
    position: relative;
  }
  /* The title link covers the whole card; the live-site link sits above it */
  .hg-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .hg-live {
    position: relative;
    z-index: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-weight: 700;
    font-size: 15px;
    color: var(--orange-glow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hg-meta {
    display: grid;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.4;
  }
  .hg-meta span:first-child {
    color: var(--text);
    font-weight: 600;
  }
  .hg-body h3 {
    font-size: clamp(20px, 1.7vw, 23px);
    margin-top: 2px;
  }
  .hg-outcome {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
  }
  .hg-more {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: 4px;
    background: var(--bg-2);
    border-top: 6px solid var(--navy);
    color: var(--muted);
    font-size: 16px;
    transition: background 0.2s;
  }
  .hg-more:hover {
    background: var(--surface-2);
  }
  .hg-more-n {
    font-family: var(--font-display);
    font-size: 72px;
    font-weight: 800;
    line-height: 1;
    color: var(--navy);
  }
  .hg-more-go {
    margin-top: auto;
    font-weight: 700;
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  @media (max-width: 960px) {
    .hg {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: 8px;
    }
    .hg-slot {
      flex: 0 0 min(78vw, 340px);
      scroll-snap-align: start;
    }
  }
</style>
