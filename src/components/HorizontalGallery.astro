---
/**
 * Homepage project row: the highlighted projects (featured: true) followed by a
 * "See every project" card. A plain row on desktop, swipeable on phones.
 */
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import Icon from './Icon.astro';
import { yearLabel } from '../lib/meta';

interface Props {
  projects: CollectionEntry<'projects'>[];
  total: number;
}
const { projects, total } = Astro.props;
---

<ul class="hg" aria-label="Highlighted projects">
  {
    projects.map((p) => (
      <li class="hg-slot">
        <a class="hg-card" href={`/projects/${p.id}/`}>
          <div class="hg-media">
            <ProjectMedia project={p} />
          </div>
          <div class="hg-body">
            <p class="hg-meta">
              {yearLabel(p.data.academicYear)} · {p.data.team.length === 1 ? p.data.team[0] : `Team of ${p.data.team.length}`}
            </p>
            <h3>{p.data.title}</h3>
            <p class="hg-outcome">{p.data.outcome ?? p.data.tagline}</p>
          </div>
        </a>
      </li>
    ))
  }
  <li class="hg-slot hg-slot-more">
    <a class="hg-more" href="/projects/">
      <span class="hg-more-n">{total}</span>
      <span>projects so far. See every one, with the parts used and how each works.</span>
      <span class="hg-more-go">All projects <Icon name="arrow" size={18} /></span>
    </a>
  </li>
</ul>

<style>
  .hg {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr) 0.75fr;
    gap: 20px;
  }
  .hg-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .hg-card:hover {
    border-color: var(--text);
    transform: translateY(-2px);
  }
  .hg-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
  }
  .hg-body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 22px;
  }
  .hg-meta {
    font-size: 14px;
    color: var(--muted);
  }
  .hg-body h3 {
    font-size: clamp(20px, 1.8vw, 24px);
  }
  .hg-outcome {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
  }
  .hg-more {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-lg);
    border: 1.5px dashed var(--border-strong);
    color: var(--muted);
    font-size: 16px;
    transition: border-color 0.2s;
  }
  .hg-more:hover {
    border-color: var(--text);
  }
  .hg-more-n {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 800;
    line-height: 1;
    color: var(--text);
  }
  .hg-more-go {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--orange-glow);
  }
  @media (max-width: 960px) {
    .hg {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: 8px;
    }
    .hg-slot {
      flex: 0 0 min(78vw, 340px);
      scroll-snap-align: start;
    }
  }
</style>
