---
/**
 * The five steps of a sprint, each with a real example from a club project
 * (Smart Dustbin for robotics, Searchable Pathfinder for software).
 * Used on the homepage and the Why Join page.
 */

interface Props {
  /** Hide the last step ("Take it further") when the page covers it separately. */
  skipLast?: boolean;
}
const { skipLast = false } = Astro.props;

const steps = [
  {
    title: 'Pick a project',
    text: "Choose a problem around school worth solving, or something you've seen and want to build: a website or a robot, depending on your stream. It has to be realistic to finish before the BA Showcase.",
    project: 'Searchable Pathfinder',
    example: "Two students found the school's paper behaviour charts slow to use, so they set out to put them online.",
  },
  {
    title: 'Plan it',
    text: "For a robot, that means a parts list and a circuit diagram. For a website, the pages, the data and who will use it. Anything you don't understand, the club leads teach you.",
    project: 'Smart Dustbin',
    example: "The team's plan caught that the distance sensor outputs 5 V but the ESP32 only takes 3.3 V, so they added a voltage divider before wiring anything.",
  },
  {
    title: 'Build it',
    text: 'Build in BA periods. Club leads help with wiring and code, and teachers supervise sawing, drilling and soldering. Robotics members order their own parts.',
    project: 'Searchable Pathfinder',
    example: 'Instead of typing out every offence by hand, Reyansh used OCR to pull the text straight from the charts.',
  },
  {
    title: 'Present at the BA Showcase',
    text: 'Every sprint ends with the BA Showcase. The whole school comes, including the principal.',
    project: 'Smart Dustbin',
    example: 'Presented on 4 November 2026, next to three other projects.',
  },
  {
    title: 'Take it further',
    text: 'After the showcase the project is yours: get the school using it, enter it in competitions, write a research paper or build an organisation around it.',
    project: 'Searchable Pathfinder',
    example: "It's already live, a teacher has given positive feedback, and the team is planning posters and video ads to get the whole school using it.",
  },
];
const shown = skipLast ? steps.slice(0, -1) : steps;
---

<ol class="steps">
  {
    shown.map((s, i) => (
      <li class="step">
        <span class="step-n">{i + 1}</span>
        <div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
        <p class="step-eg">
          <span>{s.project}</span>
          {s.example}
        </p>
      </li>
    ))
  }
</ol>
<p class="more">
  <span>Read the full projects:</span>
  <a href="/projects/smart-dustbin/">Smart Dustbin</a>
  <a href="/projects/pathfinder/">Searchable Pathfinder</a>
</p>

<style>
  .steps {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--navy);
  }
  .step {
    display: grid;
    grid-template-columns: 96px 1fr 1fr;
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--border-strong);
    align-items: start;
  }
  .step-n {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: 64px;
    line-height: 0.82;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }
  .step h3 {
    font-size: 23px;
    margin-bottom: 6px;
  }
  .step p {
    color: var(--muted);
  }
  .step-eg {
    font-size: 16px;
    padding: 14px 18px;
    background: var(--bg-2);
    border-radius: 3px;
  }
  .step-eg span {
    display: block;
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
    margin-bottom: 2px;
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 22px;
    color: var(--muted);
  }
  .more a {
    font-weight: 700;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  @media (max-width: 900px) {
    .step {
      grid-template-columns: 56px 1fr;
      gap: 16px;
    }
    .step-n {
      font-size: 40px;
    }
    .step-eg {
      grid-column: 2;
    }
  }
</style>
