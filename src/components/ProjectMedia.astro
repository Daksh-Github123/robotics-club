---
import type { CollectionEntry } from 'astro:content';
import PlaceholderArt from './PlaceholderArt.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const d = project.data;
---

{
  d.cover ? (
    <img
      class="pm-img"
      src={d.cover}
      alt={d.title}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <PlaceholderArt seed={project.id} label="PHOTO COMING SOON" />
  )
}
{d.video && <video class="pm-video" src={d.video} muted loop playsinline preload="none" data-hover-video />}
