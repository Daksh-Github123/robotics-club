---
import type { CollectionEntry } from 'astro:content';
import ContactLinks from './ContactLinks.astro';
import { initials } from '../lib/meta';

interface Props {
  member: CollectionEntry<'members'>;
  big?: boolean;
}
const { member, big = false } = Astro.props;
const d = member.data;
---

<article
  class:list={['mc', { 'mc-big': big, 'mc-alumni': d.status === 'alumni', 'mc-faculty': d.status === 'faculty' }]}
 
>
  <div class="mc-avatar">
    {d.photo ? <img src={d.photo} alt={d.name} loading="lazy" /> : <span>{initials(d.name)}</span>}
  </div>
  <div class="mc-body">
    <p class="mc-role">
      {d.founder && <span class="mc-founder">Robotics founder</span>}
      {d.role}
    </p>
    <h3>{d.name}</h3>
    {d.gradYear && <p class="mc-year">{d.status === 'alumni' ? 'Graduated' : 'Class of'} {d.gradYear}</p>}
    <ContactLinks member={member} />
    {d.bio && <p class="mc-bio">{d.bio}</p>}
    {d.placeholder && <span class="ph-pill">placeholder</span>}
  </div>
</article>

<style>
  .mc {
    display: grid;
    gap: 20px;
    align-content: start;
    height: 100%;
    padding: 26px;
    border-radius: 4px;
    border: 1px solid var(--border);
    border-top: 6px solid var(--orange);
    background: var(--surface);
  }
  .mc-faculty {
    border-top-color: var(--blue);
  }
  .mc-alumni {
    border-top-color: var(--border-strong);
  }
  .mc-avatar {
    position: relative;
    width: 84px;
    height: 84px;
  }
  .mc-avatar img,
  .mc-avatar span {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    object-fit: cover;
    display: grid;
    place-items: center;
    background: var(--orange);
    color: var(--navy);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
  }
  .mc-faculty .mc-avatar span {
    background: var(--blue);
    color: #fff;
  }
  .mc-alumni .mc-avatar span {
    background: var(--surface-2);
    color: var(--muted);
  }
  .mc-faculty .mc-role {
    color: var(--blue);
  }
  .mc-body {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .mc-role {
    font-size: 15px;
    font-weight: 700;
    color: var(--orange-glow);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .mc-founder {
    padding: 1px 9px;
    border-radius: 3px;
    background: var(--orange);
    color: var(--navy);
    font-weight: 700;
  }
  .mc h3 {
    font-size: 22px;
  }
  .mc-year {
    font-size: 14px;
    color: var(--muted);
  }
  .mc-bio {
    color: var(--muted);
    font-size: 15px;
  }
  .mc-big {
    grid-template-columns: auto 1fr;
    gap: clamp(24px, 4vw, 48px);
    padding: clamp(28px, 4vw, 48px);
    align-items: center;
  }
  .mc-big .mc-avatar {
    width: clamp(120px, 16vw, 200px);
    height: clamp(120px, 16vw, 200px);
  }
  .mc-big .mc-avatar span {
    font-size: clamp(36px, 5vw, 60px);
  }
  .mc-big h3 {
    font-size: clamp(26px, 3vw, 40px);
  }
  .mc-big .mc-bio {
    font-size: 17px;
    max-width: 52ch;
  }
  @media (max-width: 640px) {
    .mc-big {
      grid-template-columns: 1fr;
    }
  }
</style>
