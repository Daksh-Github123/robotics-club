---
/**
 * A project on the Projects page: photo on top, text underneath.
 * The title link covers the whole card; media buttons (Drive photos,
 * videos…) open in a new tab.
 */
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import Icon from './Icon.astro';
import { statusLabel, yearLabel, mediaIcon, teamNames } from '../lib/meta';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const d = project.data;
---

<div
  class:list={['pc-wrap', `size-${d.size}`]}
  data-card
  data-year={d.academicYear}
  data-stream={d.stream}
  data-cats={d.categories.map((c) => c.toLowerCase()).join('|')}
>
  <article class="pc">
    <div class="pc-media"><ProjectMedia project={project} /></div>
    <div class="pc-body">
      <span class={`stream stream-${d.stream}`}>{d.stream === 'software' ? 'Software' : 'Robotics'}</span>
      <p class="pc-meta">
        <span class={`status status-${d.status}`}>{statusLabel[d.status]}</span>
        <span>{yearLabel(d.academicYear)}</span>
        {d.team.length > 0 && <span>{teamNames(d.team)}</span>}
      </p>
      <h3><a href={`/projects/${project.id}/`} class="pc-link">{d.title}</a></h3>
      <p class="pc-tagline">{d.tagline}</p>
      {
        d.media.length > 0 && (
          <ul class="pc-mlinks" aria-label={`${d.title} photos and videos`}>
            {d.media.map((m) => (
              <li>
                <a href={m.url} target="_blank" rel="noopener">
                  <Icon name={mediaIcon[m.type] ?? 'external'} size={14} />
                  {m.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </article>
</div>

<style>
  .pc-wrap {
    min-height: 0;
  }
  .size-wide,
  .size-large {
    grid-column: span 2;
  }
  .pc {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .pc:hover {
    border-color: var(--text);
    transform: translateY(-2px);
  }
  .pc:focus-within {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
  }
  .pc-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
  }
  .size-wide .pc-media,
  .size-large .pc-media {
    aspect-ratio: 16 / 9;
  }
  .pc-body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 20px;
  }
  .pc-body .stream {
    justify-self: start;
  }
  .pc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    font-size: 14px;
    color: var(--muted);
  }
  .pc-meta .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
  .pc h3 {
    font-size: clamp(20px, 1.8vw, 24px);
  }
  /* The title link covers the whole card */
  .pc-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .pc-link:focus-visible {
    outline: none;
  }
  .pc-tagline {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
  }
  .pc-mlinks {
    position: relative;
    z-index: 2;
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  .pc-mlinks a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    color: var(--blue-glow);
    background: #e6eefb;
    transition: background 0.2s;
  }
  .pc-mlinks a:hover {
    background: #d3e1f8;
  }
  @media (max-width: 640px) {
    .size-wide,
    .size-large {
      grid-column: span 1;
    }
  }
</style>
