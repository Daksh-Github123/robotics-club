---
/** Header at the top of every sub-page. `title` may contain one <span class="grad">…</span> highlight. */
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
}
const { eyebrow, title, sub } = Astro.props;
---

<header class="page-header container">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="display" set:html={title} />
  {sub && <p class="lede">{sub}</p>}
  <slot />
</header>
