---
/**
 * Header at the top of every sub-page: title on white, closed off by a strip
 * of classroom blue (the same blue as the band on the homepage).
 */
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
}
const { eyebrow, title, sub } = Astro.props;
---

<header class="page-header">
  <div class="container ph-inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="display" set:html={title} />
    {sub && <p class="lede">{sub}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    border-bottom: 10px solid var(--blue);
  }
  .ph-inner {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .ph-inner .display {
    margin: 0;
    max-width: 20ch;
  }
</style>
