---
/**
 * The club's history as a plain vertical list on a classroom-blue rail.
 * Milestones come from src/content/milestones/*.md (oldest first).
 */
import type { CollectionEntry } from 'astro:content';
import { milestoneMeta, formatDate } from '../lib/meta';

interface Props {
  milestones: CollectionEntry<'milestones'>[];
}
const { milestones } = Astro.props;
const now = new Date();
---

<ol class="tl">
  {
    milestones.map((m) => {
      const meta = milestoneMeta[m.data.type];
      const upcoming = m.data.date > now;
      return (
        <li class:list={['tl-item', { upcoming }]}>
          <div class="tl-when">
            <time datetime={m.data.date.toISOString()}>{formatDate(m.data.date)}</time>
            <span>{upcoming ? `Upcoming ${meta.label.toLowerCase()}` : meta.label}</span>
          </div>
          <div class="tl-what">
            <h3>{m.data.title}</h3>
            <p>{m.data.summary}</p>
            {m.data.placeholder && <span class="ph-pill">placeholder date</span>}
          </div>
        </li>
      );
    })
  }
  <li class="tl-item upcoming">
    <div class="tl-when">
      <span>Coming up</span>
    </div>
    <div class="tl-what">
      <h3>What's next?</h3>
      <p>Our first funding, our first competition, more projects used around the school. We'll add them here as they happen.</p>
    </div>
  </li>
</ol>

<style>
  .tl {
    list-style: none;
    padding: 0;
    margin: clamp(36px, 5vw, 56px) 0 0;
    max-width: 920px;
    border-left: 4px solid var(--blue);
  }
  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 24px;
    padding: 22px 0 22px 32px;
    border-bottom: 1px solid var(--border);
  }
  .tl-item:last-child {
    border-bottom: 0;
  }
  /* A square marker sitting on the rail */
  .tl-item::before {
    content: '';
    position: absolute;
    left: -11px;
    top: 28px;
    width: 18px;
    height: 18px;
    background: var(--blue);
    border: 3px solid var(--bg);
  }
  .tl-item.upcoming::before {
    background: var(--bg);
    border: 3px solid var(--blue);
  }
  .tl-when {
    display: grid;
    align-content: start;
    gap: 2px;
    font-size: 15px;
    color: var(--muted);
  }
  .tl-when time {
    font-weight: 800;
    font-size: 17px;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .tl-what h3 {
    font-size: clamp(20px, 2vw, 24px);
    margin-bottom: 6px;
  }
  .tl-what p {
    color: var(--muted);
    max-width: 62ch;
  }
  .tl-what .ph-pill {
    margin-top: 10px;
  }
  @media (max-width: 640px) {
    .tl-item {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-left: 24px;
    }
  }
</style>
