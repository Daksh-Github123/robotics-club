---
/** Circular spinning text badge with an icon in the middle. */
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  text?: string;
  icon?: string;
  size?: number;
}
const { href, label, text = 'BUILD • CODE • COMPETE • SHIP • ', icon = 'arrowDown', size = 128 } = Astro.props;
const id = `spin-${Math.random().toString(36).slice(2, 8)}`;
---

<a href={href} class="spin" style={`--size:${size}px`} aria-label={label} data-magnetic>
  <svg viewBox="0 0 100 100" aria-hidden="true">
    <defs>
      <path id={id} d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"></path>
    </defs>
    <text><textPath href={`#${id}`} textLength="236">{text}</textPath></text>
  </svg>
  <span class="spin-core"><Icon name={icon} size={22} /></span>
</a>

<style>
  .spin {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
  }
  .spin svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 16s linear infinite;
  }
  .spin:hover svg {
    animation-duration: 5s;
  }
  .spin text {
    font-family: var(--font-mono);
    font-size: 8.4px;
    font-weight: 600;
    letter-spacing: 1px;
    fill: var(--text);
  }
  .spin-core {
    width: 46%;
    height: 46%;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--orange);
    color: #160800;
    box-shadow: 0 0 40px -6px var(--orange);
    transition: transform 0.4s var(--ease-out);
  }
  .spin:hover .spin-core {
    transform: scale(1.1);
  }
</style>
