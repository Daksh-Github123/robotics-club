---
/** Eyebrow + big title + optional subtitle. `title` may contain <span class="grad">…</span>. */
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, sub, align = 'left' } = Astro.props;
---

<div class:list={['sh', `sh-${align}`]}>
  {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
  <h2 class="h2" data-reveal set:html={title} />
  {sub && <p class="lede" data-reveal>{sub}</p>}
</div>

<style>
  .sh {
    display: grid;
    gap: 18px;
  }
  .sh-center {
    text-align: center;
    justify-items: center;
  }
</style>
