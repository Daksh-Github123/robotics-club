---
/** Section title with an optional subtitle. */
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, sub, align = 'left' } = Astro.props;
---

<div class:list={['sh', `sh-${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="h2" set:html={title} />
  {sub && <p class="lede">{sub}</p>}
</div>

<style>
  .sh {
    display: grid;
    gap: 12px;
  }
  .sh-center {
    text-align: center;
    justify-items: center;
  }
</style>
