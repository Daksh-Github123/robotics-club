---
/**
 * Homepage. Written to convince a new student to join, using real projects and
 * results rather than slogans. Most numbers are computed from the content files,
 * so they stay correct as projects and milestones are added.
 *
 * Layout (top to bottom): hero with photo, the blue band (like the stripe on
 * the classroom walls), projects on white, results on navy, the sprint steps,
 * quotes on mist, student-led with a photo, then the orange join block.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import SprintSteps from '../components/SprintSteps.astro';
import JoinBox from '../components/JoinBox.astro';
import TrackList from '../components/TrackList.astro';
import SignupStatus from '../components/SignupStatus.astro';
import { site } from '../site.config';
import { sortMilestones, sortProjects, yearLabel } from '../lib/meta';

// Hero photo: a file in src/assets/ named by site.heroPhoto (optimised automatically).
const assetImages = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,jpeg,png,webp}', { eager: true });
const heroImg = site.heroPhoto ? assetImages[`../assets/${site.heroPhoto}`]?.default : undefined;
// Photo for the "Run by students" section
const atWork = assetImages['../assets/members-at-work.jpg']!.default;

const milestones = sortMilestones(await getCollection('milestones'));
const projects = sortProjects(await getCollection('projects'));
const quotes = (await getCollection('quotes')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const nrl = (await getCollection('competitions')).find((c) => c.id === 'national-robotics-league');

// Up to 3 highlighted projects (featured: true), oldest first.
const featured = projects.filter((p) => p.data.featured);
const strip = (featured.length ? featured : projects).slice(0, 3).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

// Real numbers, computed at build time.
const now = new Date();
const happened = milestones.filter((m) => m.data.date <= now);
const showcases = happened.filter((m) => m.data.type === 'showcase');
const latestYear = [...new Set(projects.map((p) => p.data.academicYear))].sort().at(-1)!;
const latestProjects = projects.filter((p) => p.data.academicYear === latestYear);
const builders = new Set(latestProjects.flatMap((p) => p.data.team.map((n) => n.replace(/\s*\(.*\)$/, '')))).size;
const lastShowcase = showcases.at(-1);
// Milestones with only a known month are stored as the 1st; show those as "Mar 2026".
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    day: d.getUTCDate() === 1 ? undefined : 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<Base>
  <!-- ═════════ HERO ═════════ -->
  <section class:list={['hero', { 'has-photo': heroImg }]}>
    <div class="hero-copy">
      <p class="hero-kicker">{site.school}, student-led</p>
      <h1 class="hero-title">Build something your school can actually use.</h1>
      <p class="hero-lede">
        {site.name} is {site.school}'s student-led tech club. Members build websites and robots that solve real
        problems around school, then present them at the BA Showcase.
      </p>
      <div class="hero-cta">
        <a href="/why-join/" class="btn btn-primary">Why join?</a>
        <a href="#built" class="btn btn-ghost">See what members built</a>
      </div>
    </div>
    {
      heroImg && (
        <div class="hero-media">
          <Image
            src={heroImg}
            alt={site.heroPhotoAlt}
            widths={[700, 1100, 1600]}
            sizes="(max-width: 900px) 100vw, 52vw"
            format="webp"
            quality={78}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </section>

  <!-- The blue band: the stripe painted along the classroom walls -->
  <div class="band">
    <div class="container band-grid">
      <TrackList variant="band" />
      <SignupStatus tone="band" />
    </div>
  </div>

  <!-- ═════════ WHAT MEMBERS BUILT ═════════ -->
  <section class="section" id="built">
    <div class="container">
      <div class="head">
        <h2 class="h2">What members have built</h2>
        <p class="lede">
          {builders} students built {latestProjects.length} projects in {yearLabel(latestYear)}: websites, robots and
          sensor systems, most of them made for the school.
        </p>
      </div>
      <HorizontalGallery projects={strip} total={projects.length} />
    </div>
  </section>

  <!-- ═════════ RESULTS ═════════ -->
  <section class="section results-section">
    <div class="container results">
      <div class="head">
        <h2 class="h2">Results so far</h2>
        <p class="lede">
          {projects.length} projects so far, and {showcases.length} BA Showcases since the robotics branch started in
          September {site.founded}.
        </p>
        <a class="history-link" href="/about/#history">See the club's full history</a>
      </div>
      <ul class="log">
        {
          lastShowcase && (
            <li>
              <span class="log-date">{fmt(lastShowcase.data.date)}</span>
              <span>Projects presented at the BA Showcase, to the whole school and the principal.</span>
            </li>
          )
        }
        <li>
          <span class="log-date">Live now</span>
          <span>
            <a href="/projects/pathfinder/">Searchable Pathfinder</a>, the school's behaviour charts as a website, with
            positive feedback from a teacher.
          </span>
        </li>
        {
          nrl && nrl.data.results.length > 0 && (
            <li>
              <span class="log-date">NRL {nrl.data.results[0]!.year}</span>
              <span>
                {nrl.data.results.map((r) => r.result.replace(/^One /, 'one ')).join(', ').replace(/^one/, 'One')} from our
                school. <a href="/about/#competitions">School teams</a> are run by other teachers; club members get
                recommendations to join them.
              </span>
            </li>
          )
        }
        {
          showcases[0] && showcases[0] !== lastShowcase && (
            <li>
              <span class="log-date">{fmt(showcases[0].data.date)}</span>
              <span>First BA Showcase, at the end of Sprint 1.</span>
            </li>
          )
        }
      </ul>
    </div>
  </section>

  <!-- ═════════ HOW A SPRINT WORKS ═════════ -->
  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="h2">How a sprint works</h2>
        <p class="lede">You don't need any experience. Each step shows what a real team did.</p>
      </div>
      <SprintSteps />
    </div>
  </section>

  <!-- ═════════ QUOTES ═════════ -->
  {
    quotes.length > 0 && (
      <section class="section quotes-section">
        <div class="container">
          <h2 class="h2">In members' own words</h2>
          <div class="quotes">
            {quotes.map((q) => (
              <figure class="quote">
                <blockquote>“{q.data.text}”</blockquote>
                <figcaption>
                  <span><strong>{q.data.name}</strong>, {q.data.grade}</span>
                  {q.data.project && <span class="quote-project">{q.data.project}</span>}
                  {q.data.placeholder && <span class="ph-pill">placeholder</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ═════════ STUDENT-LED ═════════ -->
  <section class="section">
    <div class="container led">
      <figure class="led-photo">
        <Image
          src={atWork}
          alt="Two members in school uniform assembling a line-following robot kit together"
          widths={[600, 1000, 1400]}
          sizes="(max-width: 900px) 100vw, 600px"
          format="webp"
          quality={78}
        />
        <figcaption>Assembling a line-following robot in a BA period.</figcaption>
      </figure>
      <div class="led-text">
        <h2 class="h2">Run by students</h2>
        <p>
          {site.name} is one of the only student-led clubs at {site.school}. Students run the sessions and teach each
          other; Aravind Saseendran and Suprity Bhattacharya supervise.
        </p>
        <p>
          You'll work with students from other grades, including seniors you might not otherwise meet. Over time you
          can take on more: mentoring newer members, teaching a topic, or running the club after the current leads
          graduate.
        </p>
        <ul class="also">
          <li>Every project gets its own page on this site, which you can link in college and university applications.</li>
          <li>Members get recommendations for the school's competition teams.</li>
          <li>Independent competitions, like the Blue Ocean Entrepreneurship Competition, are done with the club.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═════════ JOIN ═════════ -->
  <JoinBox />
</Base>

<style>
  /* ── Hero: text on white, photo bleeding off the right edge ── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: stretch;
    padding-top: 72px; /* clears the fixed nav */
    min-height: min(84svh, 760px);
  }
  .hero:not(.has-photo) {
    grid-template-columns: 1fr;
  }
  .hero-copy {
    align-self: center;
    /* Line the text up with the page container on wide screens */
    padding-left: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    padding-right: clamp(24px, 3vw, 44px);
    padding-block: clamp(40px, 6vw, 80px);
  }
  .hero-kicker {
    font-weight: 700;
    color: var(--orange-glow);
  }
  .hero-title {
    font-size: clamp(38px, 4.3vw, 60px);
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 14px 0 22px;
    max-width: 16ch;
  }
  .hero-lede {
    font-size: clamp(18px, 1.5vw, 20px);
    color: var(--muted);
    max-width: 46ch;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
  }
  .hero-media {
    position: relative;
    min-height: 100%;
  }
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 18%;
  }

  /* ── The blue band ── */
  .band {
    background: var(--blue);
    color: #fff;
    padding-block: clamp(30px, 4vw, 44px);
  }
  .band-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    align-items: start;
  }
  /* The one motion moment: the band wipes in from the left on load */
  :global(html.js) .band {
    animation: band-wipe 0.9s var(--ease-out) 0.15s both;
  }
  @keyframes band-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* ── Shared section heads ── */
  .head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 44px);
    max-width: 720px;
  }

  /* ── Results: navy band ── */
  .results-section {
    background: var(--navy);
    color: #fff;
  }
  .results-section .lede {
    color: #c3cae0;
  }
  .results {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .results .head {
    margin-bottom: 0;
  }
  .log {
    list-style: none;
    padding: 0;
    border-top: 2px solid #fff;
  }
  .log li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    color: #e3e7f2;
  }
  .log-date {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--orange);
  }
  .history-link,
  .log a {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .history-link {
    justify-self: start;
    margin-top: 6px;
  }
  .history-link:hover,
  .log a:hover {
    text-decoration-color: #fff;
  }

  /* ── Quotes: mist panel ── */
  .quotes-section {
    background: var(--bg-2);
  }
  .quotes {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: clamp(24px, 3vw, 40px);
    margin-top: 32px;
  }
  .quote {
    margin: 0;
    padding-left: 20px;
    border-left: 5px solid var(--orange);
  }
  .quote blockquote {
    margin: 0 0 14px;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.4;
  }
  .quote figcaption {
    display: grid;
    justify-items: start;
    gap: 2px;
    font-size: 15px;
    color: var(--muted);
  }
  .quote strong {
    color: var(--text);
  }
  .quote .ph-pill {
    margin-top: 6px;
  }

  /* ── Student-led: photo + text ── */
  .led {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .led-text {
    display: grid;
    gap: 14px;
  }
  .led-text > p {
    color: var(--muted);
    max-width: 60ch;
  }
  .also {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    margin-top: 8px;
  }
  .also li {
    position: relative;
    padding-left: 22px;
  }
  .also li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 9px;
    height: 9px;
    background: var(--blue);
  }
  .led-photo {
    margin: 0;
  }
  .led-photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
    border-bottom: 8px solid var(--blue);
  }
  .led-photo figcaption {
    margin-top: 10px;
    font-size: 15px;
    color: var(--muted);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    /* Photo on top, text underneath */
    .hero,
    .hero.has-photo {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-media {
      order: -1;
      min-height: 0;
      aspect-ratio: 16 / 11;
    }
    .hero-media :global(img) {
      object-position: 45% 30%;
    }
    .hero-copy {
      padding-inline: var(--gutter);
      padding-block: 32px 44px;
    }
    .band-grid,
    .results,
    .led {
      grid-template-columns: 1fr;
    }
    .band-grid {
      gap: 22px;
    }
    .quotes {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .log li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
