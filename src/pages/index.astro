---
/**
 * Homepage. Written to convince a new student to join, using real projects and
 * results rather than slogans. Most numbers are computed from the content files,
 * so they stay correct as projects and milestones are added.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import FluidBackground from '../components/FluidBackground.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { sortMilestones, sortProjects, yearLabel } from '../lib/meta';

const milestones = sortMilestones(await getCollection('milestones'));
const projects = sortProjects(await getCollection('projects'));
const quotes = (await getCollection('quotes')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const nrl = (await getCollection('competitions')).find((c) => c.id === 'national-robotics-league');

// Up to 3 highlighted projects (featured: true), oldest first.
const featured = projects.filter((p) => p.data.featured);
const strip = (featured.length ? featured : projects).slice(0, 3).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

// Real numbers, computed at build time.
const now = new Date();
const happened = milestones.filter((m) => m.data.date <= now);
const sprints = happened.filter((m) => m.data.type === 'sprint').length;
const showcases = happened.filter((m) => m.data.type === 'showcase');
const latestYear = [...new Set(projects.map((p) => p.data.academicYear))].sort().at(-1)!;
const latestProjects = projects.filter((p) => p.data.academicYear === latestYear);
const builders = new Set(latestProjects.flatMap((p) => p.data.team)).size;
const lastShowcase = showcases.at(-1);
// Milestones with only a known month are stored as the 1st; show those as "Mar 2026".
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    day: d.getUTCDate() === 1 ? undefined : 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });

/* How a sprint works, each step shown through what the Smart Dustbin team did. */
const steps = [
  {
    title: 'Pick a project',
    text: "Think of a problem you want to solve or something you've seen and want to build. It has to be realistic to finish before the BA Showcase.",
    example: 'Adwitya, Ananya and Mihika wanted a bin nobody has to touch with dirty hands.',
  },
  {
    title: 'Plan it',
    text: "Make a parts list and a circuit diagram to check you're ordering the right parts, and work out the tools and steps. Anything you don't understand, the club leads teach you.",
    example: 'Their plan caught that the distance sensor outputs 5 V but the ESP32 only takes 3.3 V, so they added a voltage divider before wiring anything.',
  },
  {
    title: 'Order and build',
    text: 'Order your parts, bring them to school and build in BA periods. Club leads help with wiring, and teachers supervise sawing, drilling and soldering.',
    example: 'Parts ordered on 10 August. The sensor circuit was wired and bench-tested first, then the servo and lid.',
  },
  {
    title: 'Present at the BA Showcase',
    text: 'Every sprint ends with the BA Showcase. The whole school comes, including the principal.',
    example: 'Presented on 4 November 2026, next to three other Sprint 2 projects.',
  },
  {
    title: 'Take it further',
    text: 'After the showcase the project is yours: take it outside school, enter it in competitions or write a research paper on it.',
    example: "Next on their list: a second sensor that tells you when the bin is full.",
  },
];
---

<Base>
  <!-- ═════════ HERO ═════════ -->
  <section class:list={['hero', { 'hero-photo': site.heroPhoto }]}>
    {
      site.heroPhoto ? (
        <img class="hero-bg" src={site.heroPhoto} alt={site.heroPhotoAlt} fetchpriority="high" />
      ) : (
        <FluidBackground />
      )
    }
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{site.school} · student-led since {site.founded}</p>
        <h1 class="hero-title">Build a robot <span class="grad">you picked yourself</span>, then show it to the whole school.</h1>
        <p class="hero-lede">
          {site.name} is Inventure Academy's student-led robotics and tech club. You choose a project, we teach you the
          electronics and code it needs, and you present it at the BA Showcase.
        </p>
        <div class="hero-cta">
          <a href="#join" class="btn btn-primary">How to join <Icon name="arrow" size={18} /></a>
          <a href="#built" class="btn btn-ghost">See what members built</a>
        </div>
        <p class="hero-note">Sign-ups run through BA and are first come, first served.</p>
      </div>
      {
        !site.heroPhoto && (
          <div class="hero-visual" data-hero-visual>
            <canvas data-hero3d aria-hidden="true" />
          </div>
        )
      }
    </div>
  </section>

  <!-- ═════════ WHAT MEMBERS BUILT ═════════ -->
  <section class="section" id="built">
    <div class="container">
      <div class="head">
        <h2 class="h2">What members have built</h2>
        <p class="lede">
          {builders} students built {latestProjects.length} projects in {yearLabel(latestYear)}. For most of them it was
          their first electronics project.
        </p>
      </div>
      <HorizontalGallery projects={strip} total={projects.length} />
    </div>
  </section>

  <!-- ═════════ RESULTS ═════════ -->
  <section class="section results-section">
    <div class="container results">
      <div class="head">
        <h2 class="h2">Results so far</h2>
        <p class="lede">
          {projects.length} projects, {sprints} sprints and {showcases.length} BA Showcases since the club started in
          September {site.founded}.
        </p>
      </div>
      <ul class="log">
        {
          lastShowcase && (
            <li>
              <span class="log-date">{fmt(lastShowcase.data.date)}</span>
              <span>
                {latestProjects.length} projects presented at the BA Showcase, to the whole school and the principal.
              </span>
            </li>
          )
        }
        {
          nrl && nrl.data.results.length > 0 && (
            <li>
              <span class="log-date">NRL {nrl.data.results[0]!.year}</span>
              <span>
                {nrl.data.results.map((r) => r.result.replace(/^One /, 'one ')).join(', ').replace(/^one/, 'One')} from our
                school. <a href="/competitions/">School teams</a> are run by other teachers; club members get
                recommendations to join them.
              </span>
            </li>
          )
        }
        {
          showcases[0] && showcases[0] !== lastShowcase && (
            <li>
              <span class="log-date">{fmt(showcases[0].data.date)}</span>
              <span>First BA Showcase, at the end of Sprint 1, when every member had built the same line follower.</span>
            </li>
          )
        }
      </ul>
    </div>
  </section>

  <!-- ═════════ HOW A SPRINT WORKS ═════════ -->
  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="h2">How a sprint works</h2>
        <p class="lede">You don't need any experience. Here's one real sprint, followed through the Smart Dustbin team.</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step-n">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
              <p class="step-eg">
                <span>Smart Dustbin</span>
                {s.example}
              </p>
            </li>
          ))
        }
      </ol>
      <a class="more-link" href="/projects/smart-dustbin/">Read the Smart Dustbin project page <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <!-- ═════════ QUOTES ═════════ -->
  {
    quotes.length > 0 && (
      <section class="section quotes-section">
        <div class="container">
          <h2 class="h2">In members' own words</h2>
          <div class="quotes">
            {quotes.map((q) => (
              <figure class="quote">
                <blockquote>“{q.data.text}”</blockquote>
                <figcaption>
                  <strong>{q.data.name}</strong>, {q.data.grade}
                  {q.data.project && <span> · {q.data.project}</span>}
                  {q.data.placeholder && <span class="ph-pill">placeholder</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ═════════ STUDENT-LED ═════════ -->
  <section class="section">
    <div class="container led">
      <div class="led-text">
        <h2 class="h2">Run by students</h2>
        <p>
          {site.name} is one of the only student-led clubs at {site.school}. Students run the sessions and teach each
          other; Aravind Saseendran and Suprity Bhattacharya supervise.
        </p>
        <p>
          You'll work with students from other grades, including seniors you might not otherwise meet. Over time you
          can take on more: mentoring newer members, teaching a topic, or running the club after the current leads
          graduate.
        </p>
        <ul class="also">
          <li>Every project gets its own page on this site, which you can link in applications.</li>
          <li>Members get recommendations for the school's competition teams.</li>
          <li>Independent competitions, like the Blue Ocean Entrepreneurship Competition, are done with the club.</li>
        </ul>
      </div>
      <div class="led-photo" role="img" aria-label="Photo coming soon: members at work">
        <span>Photo coming soon</span>
        <span>Members at work in a BA period</span>
      </div>
    </div>
  </section>

  <!-- ═════════ JOIN ═════════ -->
  <section class="section" id="join">
    <div class="container">
      <div class="join">
        <div>
          <h2 class="h2">Joining</h2>
          <p class="lede">Sign up when the school opens Beyond Academics (BA) sign-ups. Spots go fast.</p>
          <div class="join-cta">
            <a href="/join/" class="btn btn-primary">Full details and FAQ <Icon name="arrow" size={18} /></a>
            <a href="/join/#contacts" class="btn btn-ghost">Ask a question</a>
          </div>
        </div>
        <dl class="facts">
          <div><dt>Sign-ups</dt><dd>BA sign-ups, first come, first served</dd></div>
          <div><dt>When</dt><dd>{site.meeting.when}</dd></div>
          <div><dt>Where</dt><dd>{site.meeting.where}</dd></div>
          <div><dt>Cost</dt><dd>You buy the parts for your own project, after planning exactly what you need</dd></div>
          <div><dt>Experience</dt><dd>None needed</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ═════════ TIMELINE ═════════ -->
  <section class="section" id="journey">
    <div class="container">
      <div class="head">
        <h2 class="h2">The club so far</h2>
        <p class="lede">From the first meeting in September {site.founded} to now.</p>
      </div>
      <Timeline milestones={milestones} />
    </div>
  </section>
</Base>

<script>
  import { reducedMotion } from '../scripts/motion';

  // Load the 3D gears once the page is idle (only when there's no hero photo).
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero3d]');
  if (canvas && !reducedMotion) {
    const go = () => import('../scripts/hero3d').then((m) => m.initHero3D(canvas));
    if ('requestIdleCallback' in window) window.requestIdleCallback(go, { timeout: 1200 });
    else setTimeout(go, 400);
  }
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(92svh, 860px);
    display: grid;
    align-items: center;
    padding-top: 100px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: center;
  }
  .hero-kicker {
    font-weight: 700;
    color: var(--orange-glow);
  }
  .hero-title {
    font-size: clamp(36px, 4.6vw, 60px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 14px 0 20px;
    max-width: 16ch;
  }
  .hero-lede {
    font-size: clamp(18px, 1.5vw, 20px);
    color: var(--muted);
    max-width: 46ch;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .hero-note {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 680px;
    aspect-ratio: 1;
    justify-self: end;
  }
  .hero-visual canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Photo hero: photo fills the section, text sits on a dark scrim. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(20, 16, 12, 0.78) 0%, rgba(20, 16, 12, 0.45) 55%, rgba(20, 16, 12, 0.1) 100%);
  }
  .hero-photo .hero-grid {
    grid-template-columns: 1fr;
  }
  .hero-photo .hero-copy,
  .hero-photo .hero-lede,
  .hero-photo .hero-note {
    color: #fff;
  }
  .hero-photo .hero-kicker {
    color: #ffc79e;
  }
  .hero-photo .grad {
    background: none;
    color: #ffb27a;
  }
  .hero-photo .btn-ghost {
    border-color: #fff;
    color: #fff;
  }

  /* ── Shared section heads ── */
  .head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 44px);
    max-width: 720px;
  }

  /* ── Results log ── */
  .results-section {
    background: var(--bg-2);
    border-block: 1px solid var(--border);
  }
  .results {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .results .head {
    margin-bottom: 0;
  }
  .log {
    list-style: none;
    padding: 0;
    border-top: 1.5px solid var(--text);
  }
  .log li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border-strong);
  }
  .log-date {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--orange-glow);
    padding-top: 3px;
  }
  .log a {
    color: var(--orange-glow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Sprint steps ── */
  .steps {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }
  .step {
    display: grid;
    grid-template-columns: 48px 1fr 1fr;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border-strong);
    align-items: start;
  }
  .step-n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 28px;
    line-height: 1;
    color: var(--orange);
  }
  .step h3 {
    font-size: 22px;
    margin-bottom: 6px;
  }
  .step p {
    color: var(--muted);
  }
  .step-eg {
    font-size: 16px;
    padding-left: 18px;
    border-left: 3px solid var(--orange-soft);
  }
  .step-eg span {
    display: block;
    font-weight: 700;
    font-size: 14px;
    color: var(--text);
    margin-bottom: 2px;
  }
  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-weight: 700;
    color: var(--orange-glow);
  }

  /* ── Quotes ── */
  .quotes-section {
    padding-top: 0;
  }
  .quotes {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
  }
  .quote {
    margin: 0;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .quote:nth-child(2) {
    transform: rotate(-0.6deg);
  }
  .quote:nth-child(3) {
    transform: rotate(0.5deg);
  }
  .quote blockquote {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.35;
  }
  .quote figcaption {
    font-size: 15px;
    color: var(--muted);
  }
  .quote .ph-pill {
    margin-left: 8px;
  }

  /* ── Student-led ── */
  .led {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .led-text {
    display: grid;
    gap: 14px;
  }
  .led-text > p {
    color: var(--muted);
  }
  .also {
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
    margin-top: 6px;
  }
  .also li::marker {
    color: var(--orange);
  }
  .led-photo {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    display: grid;
    place-content: center;
    text-align: center;
    gap: 4px;
    color: var(--faint);
    font-size: 15px;
    background:
      repeating-linear-gradient(-45deg, transparent 0 14px, rgba(26, 22, 17, 0.035) 14px 15px),
      var(--surface-2);
  }
  .led-photo span:first-child {
    font-weight: 700;
  }

  /* ── Join ── */
  .join {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    padding: clamp(24px, 4vw, 44px);
    background: var(--surface);
    border: 1.5px solid var(--text);
    border-radius: var(--radius-lg);
  }
  .join .lede {
    margin-top: 10px;
  }
  .join-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .facts {
    margin: 0;
    display: grid;
  }
  .facts div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
  }
  .facts div:last-child {
    border-bottom: 0;
  }
  .facts dt {
    font-weight: 700;
  }
  .facts dd {
    margin: 0;
    color: var(--muted);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero-grid,
    .results,
    .led,
    .join {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      position: absolute;
      z-index: -1;
      top: auto;
      bottom: -30%;
      right: -45%;
      width: 100vw;
      max-width: none;
      opacity: 0.22;
      pointer-events: none;
    }
    .step {
      grid-template-columns: 36px 1fr;
    }
    .step-eg {
      grid-column: 2;
    }
    .quotes {
      grid-template-columns: 1fr;
    }
    .quote:nth-child(n) {
      transform: none;
    }
  }
  @media (max-width: 520px) {
    .log li,
    .facts div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
