---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SpinBadge from '../components/SpinBadge.astro';
import Marquee from '../components/Marquee.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { sortMilestones, sortProjects } from '../lib/meta';

const milestones = sortMilestones(await getCollection('milestones'));
const projects = sortProjects(await getCollection('projects'));
const members = await getCollection('members');
const featured = projects.filter((p) => p.data.featured);
// The homepage strip shows up to 3 highlighted projects (featured: true), then a "See every project" card.
const strip = (featured.length ? featured : projects)
  .slice(0, 3)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf()); // oldest first

// Only count sprints and showcases that have already happened (counted when the site is built).
const happened = milestones.filter((m) => m.data.date <= new Date());
const stats = [
  { n: projects.length, label: 'Projects built' },
  { n: members.filter((m) => m.data.status === 'current').length, label: 'Core members' },
  { n: happened.filter((m) => m.data.type === 'sprint').length, label: 'Sprints run' },
  { n: happened.filter((m) => m.data.type === 'showcase').length, label: 'Showcases' },
];

/* Hero headline: each letter is its own span so it can animate in. */
const lines = ['BUILD.', 'CODE.', 'COMPETE.'];
const stops = [
  [255, 122, 26],
  [255, 179, 107],
  [95, 160, 255],
];
function gradColor(t: number) {
  const seg = t < 0.5 ? 0 : 1;
  const k = (t - seg * 0.5) * 2;
  const [a, b] = [stops[seg]!, stops[seg + 1]!];
  return `rgb(${a.map((v, i) => Math.round(v + (b[i]! - v) * k)).join(',')})`;
}

/* What being a student-led club means for members. */
const led = [
  {
    icon: 'users',
    accent: '--orange',
    title: 'Work with peers and seniors',
    text: "You'll build alongside students from other grades, including seniors you might not otherwise get to know.",
  },
  {
    icon: 'chat',
    accent: '--blue',
    title: 'Make real connections',
    text: 'The people you build with become teammates, mentors and friends you can ask for advice long after a sprint ends.',
  },
  {
    icon: 'rocket',
    accent: '--green',
    title: 'Step up and lead',
    text: 'Because students run the club, you can take on more over time: mentoring newer members, teaching a topic, or leading the club once the current leads graduate.',
  },
];

/* How every sprint runs, step by step. */
const doCards = [
  {
    icon: 'lightbulb',
    accent: '--orange',
    title: 'Pick a project',
    text: "Think of a problem you want to solve, a project idea, or something interesting you've seen and want to build. It just needs to be realistic to finish before the BA Showcase.",
  },
  {
    icon: 'file',
    accent: '--blue',
    title: 'Plan it',
    text: "Make a parts list and a circuit diagram to check you're ordering the right parts. Work out the tools you need and how you'll build it, plus any research, cloud setup or sensor calibration. If something doesn't make sense, the club leads teach it to you.",
  },
  {
    icon: 'wrench',
    accent: '--yellow',
    title: 'Order and build',
    text: 'Order your parts, bring them to school and build there. Club leads help you wire things up when you get stuck, and supervise sawing, drilling and soldering with the teachers.',
  },
  {
    icon: 'star',
    accent: '--orange',
    title: 'Present at the BA Showcase',
    text: 'Every sprint ends with the BA Showcase, where the whole school, including the principal, comes to see what you built.',
  },
  {
    icon: 'rocket',
    accent: '--green',
    title: 'Take it further',
    text: 'After the showcase the project is yours. Take it outside school, start your own organization around it, enter it in competitions or write a research paper on it.',
  },
];

const why = [
  {
    title: 'A portfolio that proves it',
    text: 'Every project gets its own page on this site: your name, your role, what you built and how it works. Drop the link straight into college applications.',
  },
  {
    title: 'Recommendations for school teams',
    text: "The school's competition teams are run by other teachers. Club members get recommendations so they can join those teams straight away.",
  },
  {
    title: 'Independent competitions together',
    text: 'Independent competitions are done with the club. Members help each other plan, build and prepare their entries.',
  },
  {
    title: 'Ideas that get implemented',
    text: 'Pitch a fix for a real problem at school, build it with a team, and get it installed on campus.',
  },
];


function gear(cx: number, cy: number, ro: number, ri: number, n: number) {
  let d = '';
  const s = (Math.PI * 2) / n;
  for (let i = 0; i < n; i++) {
    const t0 = i * s;
    (
      [
        [ri, t0],
        [ro, t0 + s * 0.16],
        [ro, t0 + s * 0.44],
        [ri, t0 + s * 0.6],
      ] as [number, number][]
    ).forEach(([r, t], j) => {
      d += `${i === 0 && j === 0 ? 'M' : 'L'}${(cx + Math.cos(t) * r).toFixed(1)} ${(cy + Math.sin(t) * r).toFixed(1)} `;
    });
  }
  return d + 'Z';
}
---

<Base>
  <!-- ═════════ HERO ═════════ -->
  <section class="hero" data-hero>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-hero-fade>{site.school} · Student-led · Est. {site.founded}</p>
        <h1 class="hero-title" aria-label={`${lines.join(' ')} ${site.name}.`}>
          {
            lines.map((line, li) => (
              <span class="line" aria-hidden="true">
                {[...line].map((ch, ci) => (
                  <span
                    class="ch"
                    style={li === lines.length - 1 ? `color:${gradColor(ci / (line.length - 1))}` : undefined}
                  >
                    {ch}
                  </span>
                ))}
              </span>
            ))
          }
        </h1>
        <p class="lede hero-lede" data-hero-fade>
          At <strong>{site.name}</strong>, students pick their own robotics project, learn what it needs, build it in
          school and present it to the whole school.
        </p>
        <div class="hero-cta" data-hero-fade>
          <a href="/projects/" class="btn btn-primary" data-magnetic>Explore projects <Icon name="arrow" size={18} /></a>
          <a href="#journey" class="btn btn-ghost" data-magnetic>Our journey</a>
        </div>
      </div>

      <div class="hero-visual" data-hero-visual>
        <div class="hero-glow"></div>
        <svg class="hero-fallback" viewBox="0 0 400 400" aria-hidden="true">
          <g fill="none" stroke-width="2" stroke-linejoin="round">
            <path d={gear(185, 210, 120, 98, 14)} stroke="#FF7A1A"></path>
            <circle cx="185" cy="210" r="30" stroke="#FF7A1A"></circle>
            <path d={gear(305, 110, 76, 60, 9)} stroke="#2F7BFF"></path>
            <circle cx="200" cy="200" r="190" stroke="#2F7BFF" stroke-opacity=".25" stroke-dasharray="4 10"></circle>
          </g>
        </svg>
        <canvas data-hero3d aria-hidden="true"></canvas>
      </div>
    </div>
    <div class="hero-badge" data-hero-fade>
      <SpinBadge href="#journey" label="Scroll to our journey" text="SCROLL • BUILD • CODE • COMPETE • " />
    </div>
  </section>

  <!-- ═════════ STATS + TICKER ═════════ -->
  <section class="stats-wrap" aria-label="Club in numbers">
    <div class="container">
      <dl class="stats" data-reveal-group>
        {
          stats.map((s) => (
            <div class="stat">
              <dt class="stat-l">{s.label}</dt>
              <dd class="stat-n" data-count={s.n}>
                {s.n}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <Marquee words={['BUILD', 'CODE', 'SOLDER', 'COMPETE', 'SHIP', 'REPEAT']} />
  </section>

  <!-- ═════════ WHAT YOU'LL DO ═════════ -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="How a sprint works"
        title='What you&#39;ll <span class="grad">do</span>'
        sub="Every sprint follows these steps. You don't need experience to join, because you learn what your project needs while you build it."
      />
      <div class="do-grid" data-reveal-group>
        {
          doCards.map((c, i) => (
            <article class="do-card" data-glow style={`--accent: var(${c.accent})`}>
              <span class="do-k" aria-hidden="true">
                0{i + 1}
              </span>
              <span class="do-icon">
                <Icon name={c.icon} size={26} />
              </span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═════════ PROJECT STRIP ═════════ -->
  <HorizontalGallery projects={strip} />

  <!-- ═════════ STUDENT-LED ═════════ -->
  <section class="section led-section">
    <div class="container">
      <div class="led-head">
        <p class="eyebrow" data-reveal>Student-led</p>
        <h2 class="h2" data-reveal>Run by <span class="grad">students.</span></h2>
        <p class="lede" data-reveal>
          Robotics Club is fully student-led, one of the only student-led clubs at {site.school}. Students run the
          sessions, teach each other and build the projects, with supervision from faculty.
        </p>
      </div>
      <div class="led-grid" data-reveal-group>
        {
          led.map((l) => (
            <article class="led-card" data-glow style={`--accent: var(${l.accent})`}>
              <span class="led-icon">
                <Icon name={l.icon} size={24} />
              </span>
              <h3>{l.title}</h3>
              <p>{l.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═════════ WHY JOIN ═════════ -->
  <section class="section why-section">
    <div class="container why">
      <div class="why-sticky">
        <p class="eyebrow" data-reveal>Why join</p>
        <h2 class="h2" data-reveal>Build things you can <span class="grad">show people.</span></h2>
        <p class="lede" data-reveal>
          Colleges want to see what you've built and what you did on the team. Every club project is documented here.
        </p>
        <a href="/join/" class="btn btn-primary" data-reveal data-magnetic>How to join <Icon name="arrow" size={18} /></a>
      </div>
      <ol class="why-list">
        {
          why.map((w, i) => (
            <li class="why-item" data-reveal>
              <span class="why-k mono">0{i + 1}</span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═════════ TIMELINE ═════════ -->
  <section class="section" id="journey">
    <div class="container">
      <SectionHeading
        eyebrow="Timeline"
        title='Our story <span class="grad">so far</span>'
        sub="Every sprint, showcase and first since the club started."
        align="center"
      />
    </div>
    <div class="container">
      <Timeline milestones={milestones} />
    </div>
  </section>

  <!-- ═════════ CTA ═════════ -->
  <section class="cta">
    <div class="cta-ring" aria-hidden="true"></div>
    <div class="cta-ring cta-ring-2" aria-hidden="true"></div>
    <div class="container cta-inner">
      <p class="eyebrow" data-reveal>Join us</p>
      <h2 data-reveal>Want to build<br /><span class="grad">with us?</span></h2>
      <p class="lede" data-reveal>{site.applyInfo}</p>
      <div class="cta-actions" data-reveal>
        <a href="/join/" class="btn btn-primary" data-magnetic>How to join <Icon name="arrow" size={18} /></a>
        <a href="/team/" class="btn btn-ghost" data-magnetic>Meet the team</a>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // Hide the hero headline until its intro animation is ready (with a safety timeout).
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('hero-pending');
    setTimeout(() => document.documentElement.classList.remove('hero-pending'), 2500);
  }
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reducedMotion } from '../scripts/motion';
  gsap.registerPlugin(ScrollTrigger);

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !reducedMotion) {
    const chars = hero.querySelectorAll('.ch');
    const fades = hero.querySelectorAll('[data-hero-fade]');
    const visual = hero.querySelector('[data-hero-visual]');
    // y: 0 clears the pixel offset GSAP would otherwise inherit from the .hero-pending CSS.
    gsap.set(chars, { y: 0, yPercent: 115, rotate: 8 });
    gsap.set(fades, { y: 26, opacity: 0 });
    gsap.set(visual, { scale: 0.75, opacity: 0 });
    document.documentElement.classList.remove('hero-pending');

    gsap
      .timeline({ defaults: { ease: 'expo.out' }, delay: 0.1 })
      .to(chars, { yPercent: 0, rotate: 0, duration: 1.2, stagger: 0.028 })
      .to(visual, { scale: 1, opacity: 1, duration: 1.6 }, 0.15)
      .to(fades, { y: 0, opacity: 1, duration: 1, stagger: 0.08 }, 0.45);

    // Hero drifts away as you scroll past it
    gsap.to('.hero-copy', {
      yPercent: -14,
      opacity: 0.15,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to(visual, {
      yPercent: 18,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
    });

    // Load the 3D gear once the page is idle
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero3d]');
    if (canvas) {
      const go = () => import('../scripts/hero3d').then((m) => m.initHero3D(canvas));
      if ('requestIdleCallback' in window) window.requestIdleCallback(go, { timeout: 1200 });
      else setTimeout(go, 400);
    }
  }
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: 110px;
    padding-bottom: 80px;
    isolation: isolate;
    overflow-x: clip;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 32px;
    align-items: center;
  }
  .hero-copy {
    container-type: inline-size;
  }
  .hero-title {
    /* Sized from the column width so the longest word ("COMPETE.") always fits on one line. */
    font-size: min(12.5cqi, 104px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.045em;
    margin: 22px 0 30px;
  }
  .hero-title .line {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    padding-block: 0.1em 0.04em;
    margin-block: -0.07em;
  }
  .hero-title .ch {
    display: inline-block;
    will-change: transform;
  }
  :global(.hero-pending) .hero-title .ch {
    transform: translateY(115%);
  }
  :global(.hero-pending) [data-hero-fade],
  :global(.hero-pending) .hero-visual {
    opacity: 0;
  }
  .hero-lede strong {
    color: var(--text);
    font-weight: 600;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 760px;
    aspect-ratio: 1;
    justify-self: end;
  }
  .hero-visual canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-glow {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 40% 40%, rgba(255, 122, 26, 0.35), transparent 60%),
      radial-gradient(circle at 65% 65%, rgba(47, 123, 255, 0.3), transparent 60%);
    filter: blur(50px);
  }
  .hero-fallback {
    position: absolute;
    inset: 8%;
    width: 84%;
    height: 84%;
    opacity: 0.85;
    transition: opacity 0.8s;
    animation: spin 40s linear infinite;
  }
  .hero-visual:global(.has-3d) .hero-fallback {
    opacity: 0;
  }
  .hero-badge {
    position: absolute;
    right: var(--gutter);
    bottom: 32px;
  }

  /* ── Stats ── */
  .stats-wrap {
    padding-block: 40px 20px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0 0 clamp(40px, 6vw, 72px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    overflow: hidden;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: clamp(24px, 3vw, 40px);
    border-right: 1px solid var(--border);
  }
  .stat:last-child {
    border-right: 0;
  }
  .stat-n {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(36px, 4.2vw, 60px);
    line-height: 1;
    letter-spacing: -0.04em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-l {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── What you'll do ── */
  .do-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .do-card {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    min-height: 300px;
    padding: clamp(26px, 3vw, 38px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 75%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
    transition:
      border-color 0.4s,
      transform 0.5s var(--ease-out);
  }
  .do-card:nth-child(1),
  .do-card:nth-child(4) {
    grid-column: span 7;
  }
  .do-card:nth-child(2),
  .do-card:nth-child(3) {
    grid-column: span 5;
  }
  .do-card:nth-child(5) {
    grid-column: span 12;
    min-height: 240px;
  }
  .do-card:nth-child(5) p {
    max-width: 70ch;
  }
  .do-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    transform: translateY(-4px);
  }
  .do-k {
    position: absolute;
    right: 22px;
    top: 6px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(56px, 6vw, 92px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--border-strong);
    transition: -webkit-text-stroke-color 0.4s;
    z-index: -1;
  }
  .do-card:hover .do-k {
    -webkit-text-stroke-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .do-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow: 0 0 30px -10px var(--accent);
  }
  .do-card h3 {
    font-size: clamp(24px, 2.6vw, 34px);
    margin-bottom: 12px;
  }
  .do-card p {
    color: var(--muted);
    max-width: 46ch;
  }

  /* ── Student-led ── */
  .led-section {
    padding-bottom: 0;
  }
  .led-head {
    display: grid;
    gap: 20px;
    max-width: 820px;
  }
  .led-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: clamp(36px, 5vw, 56px);
  }
  .led-card {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: clamp(24px, 2.6vw, 32px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 75%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
    transition: border-color 0.4s;
  }
  .led-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
  }
  .led-icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .led-card h3 {
    font-size: clamp(20px, 2vw, 26px);
  }
  .led-card p {
    color: var(--muted);
    font-size: 15.5px;
  }

  /* ── Why join ── */
  .why {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .why-sticky {
    position: sticky;
    top: 120px;
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .why-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .why-item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding: clamp(28px, 3.5vw, 44px) 0;
    border-bottom: 1px solid var(--border);
  }
  .why-k {
    font-size: 14px;
    color: var(--faint);
    padding-top: 8px;
    transition: color 0.3s;
  }
  .why-item:hover .why-k {
    color: var(--orange);
  }
  .why-item h3 {
    font-size: clamp(22px, 2.4vw, 32px);
    margin-bottom: 12px;
    transition: transform 0.4s var(--ease-out);
  }
  .why-item:hover h3 {
    transform: translateX(8px);
  }
  .why-item p {
    color: var(--muted);
  }

  /* ── CTA ── */
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
    padding-block: clamp(110px, 16vw, 210px);
  }
  .cta-inner {
    display: grid;
    gap: 24px;
    justify-items: center;
