---
/**
 * Homepage. Written to convince a new student to join, using real projects and
 * results rather than slogans. Most numbers are computed from the content files,
 * so they stay correct as projects and milestones are added.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import SprintSteps from '../components/SprintSteps.astro';
import JoinBox from '../components/JoinBox.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { sortMilestones, sortProjects, yearLabel } from '../lib/meta';

const milestones = sortMilestones(await getCollection('milestones'));
const projects = sortProjects(await getCollection('projects'));
const quotes = (await getCollection('quotes')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const nrl = (await getCollection('competitions')).find((c) => c.id === 'national-robotics-league');

// Up to 3 highlighted projects (featured: true), oldest first.
const featured = projects.filter((p) => p.data.featured);
const strip = (featured.length ? featured : projects).slice(0, 3).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

// Real numbers, computed at build time.
const now = new Date();
const happened = milestones.filter((m) => m.data.date <= now);
const sprints = happened.filter((m) => m.data.type === 'sprint').length;
const showcases = happened.filter((m) => m.data.type === 'showcase');
const latestYear = [...new Set(projects.map((p) => p.data.academicYear))].sort().at(-1)!;
const latestProjects = projects.filter((p) => p.data.academicYear === latestYear);
const builders = new Set(latestProjects.flatMap((p) => p.data.team.map((n) => n.replace(/\s*\(.*\)$/, '')))).size;
const lastShowcase = showcases.at(-1);
// Milestones with only a known month are stored as the 1st; show those as "Mar 2026".
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    day: d.getUTCDate() === 1 ? undefined : 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });

/* The club's two kinds of project, each with a real example. */
const tracks = [
  {
    label: 'Software',
    text: 'Websites that digitise school systems and fix everyday problems.',
    example: 'A searchable version of the Pathfinder behaviour charts',
    href: '/projects/pathfinder/',
  },
  {
    label: 'Robotics',
    text: 'Robots and sensors that solve problems around school.',
    example: 'A touch-free smart dustbin',
    href: '/projects/smart-dustbin/',
  },
];
---

<Base>
  <!-- ═════════ HERO ═════════ -->
  <section class:list={['hero', { 'hero-photo': site.heroPhoto }]}>
    {site.heroPhoto && <img class="hero-bg" src={site.heroPhoto} alt={site.heroPhotoAlt} fetchpriority="high" />}
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{site.school} · student-led since {site.founded}</p>
        <h1 class="hero-title">Build something your school can <span class="grad">actually use</span>.</h1>
        <p class="hero-lede">
          {site.name} is {site.school}'s student-led tech club. Members build websites and robots that solve real
          problems around school, then present them at the BA Showcase.
        </p>
        <div class="hero-cta">
          <a href="/why-join/" class="btn btn-primary">Why join? <Icon name="arrow" size={18} /></a>
          <a href="#built" class="btn btn-ghost">See what members built</a>
        </div>
        <p class="hero-note">Sign-ups run through BA and are first come, first served.</p>
      </div>
      <ul class="tracks" aria-label="What members build">
        {
          tracks.map((t) => (
            <li>
              <a href={t.href} class="track">
                <span class="track-label">{t.label}</span>
                <span class="track-text">{t.text}</span>
                <span class="track-eg">
                  e.g. {t.example} <Icon name="arrow" size={15} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═════════ WHAT MEMBERS BUILT ═════════ -->
  <section class="section" id="built">
    <div class="container">
      <div class="head">
        <h2 class="h2">What members have built</h2>
        <p class="lede">
          {builders} students built {latestProjects.length} projects in {yearLabel(latestYear)}: websites, robots and
          sensor systems, most of them made for the school.
        </p>
      </div>
      <HorizontalGallery projects={strip} total={projects.length} />
    </div>
  </section>

  <!-- ═════════ RESULTS ═════════ -->
  <section class="section results-section">
    <div class="container results">
      <div class="head">
        <h2 class="h2">Results so far</h2>
        <p class="lede">
          {projects.length} projects, {sprints} sprints and {showcases.length} BA Showcases since September {site.founded}.
        </p>
      </div>
      <ul class="log">
        {
          lastShowcase && (
            <li>
              <span class="log-date">{fmt(lastShowcase.data.date)}</span>
              <span>Sprint 2 projects presented at the BA Showcase, to the whole school and the principal.</span>
            </li>
          )
        }
        <li>
          <span class="log-date">Live now</span>
          <span>
            <a href="/projects/pathfinder/">Searchable Pathfinder</a>, the school's behaviour charts as a website, with
            positive feedback from a teacher.
          </span>
        </li>
        {
          nrl && nrl.data.results.length > 0 && (
            <li>
              <span class="log-date">NRL {nrl.data.results[0]!.year}</span>
              <span>
                {nrl.data.results.map((r) => r.result.replace(/^One /, 'one ')).join(', ').replace(/^one/, 'One')} from our
                school. <a href="/competitions/">School teams</a> are run by other teachers; club members get
                recommendations to join them.
              </span>
            </li>
          )
        }
        {
          showcases[0] && showcases[0] !== lastShowcase && (
            <li>
              <span class="log-date">{fmt(showcases[0].data.date)}</span>
              <span>First BA Showcase, at the end of Sprint 1.</span>
            </li>
          )
        }
      </ul>
    </div>
  </section>

  <!-- ═════════ HOW A SPRINT WORKS ═════════ -->
  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="h2">How a sprint works</h2>
        <p class="lede">You don't need any experience. Each step shows what a real team did.</p>
      </div>
      <SprintSteps />
    </div>
  </section>

  <!-- ═════════ QUOTES ═════════ -->
  {
    quotes.length > 0 && (
      <section class="section quotes-section">
        <div class="container">
          <h2 class="h2">In members' own words</h2>
          <div class="quotes">
            {quotes.map((q) => (
              <figure class="quote">
                <blockquote>“{q.data.text}”</blockquote>
                <figcaption>
                  <strong>{q.data.name}</strong>, {q.data.grade}
                  {q.data.project && <span> · {q.data.project}</span>}
                  {q.data.placeholder && <span class="ph-pill">placeholder</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ═════════ STUDENT-LED ═════════ -->
  <section class="section">
    <div class="container led">
      <div class="led-text">
        <h2 class="h2">Run by students</h2>
        <p>
          {site.name} is one of the only student-led clubs at {site.school}. Students run the sessions and teach each
          other; Aravind Saseendran and Suprity Bhattacharya supervise.
        </p>
        <p>
          You'll work with students from other grades, including seniors you might not otherwise meet. Over time you
          can take on more: mentoring newer members, teaching a topic, or running the club after the current leads
          graduate.
        </p>
        <ul class="also">
          <li>Every project gets its own page on this site, which you can link in applications.</li>
          <li>Members get recommendations for the school's competition teams.</li>
          <li>Independent competitions, like the Blue Ocean Entrepreneurship Competition, are done with the club.</li>
        </ul>
      </div>
      <div class="led-photo" role="img" aria-label="Photo coming soon: members at work">
        <span>Photo coming soon</span>
        <span>Members at work in a BA period</span>
      </div>
    </div>
  </section>

  <!-- ═════════ JOIN ═════════ -->
  <section class="section" id="join">
    <div class="container">
      <JoinBox />
    </div>
  </section>

  <!-- ═════════ TIMELINE ═════════ -->
  <section class="section" id="journey">
    <div class="container">
      <div class="head">
        <h2 class="h2">The club so far</h2>
        <p class="lede">From the first meeting in September {site.founded} to now.</p>
      </div>
      <Timeline milestones={milestones} />
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(120px, 14vw, 170px);
    padding-bottom: clamp(56px, 7vw, 96px);
    border-bottom: 1px solid var(--border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
  }
  .hero-kicker {
    font-weight: 700;
    color: var(--orange-glow);
  }
  .hero-title {
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 14px 0 20px;
    max-width: 15ch;
  }
  .hero-lede {
    font-size: clamp(18px, 1.5vw, 20px);
    color: var(--muted);
    max-width: 50ch;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .hero-note {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }
  .tracks {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .track {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--orange);
    border-radius: var(--radius);
    transition: border-color 0.2s;
  }
  .tracks li:nth-child(2) .track {
    border-left-color: var(--blue);
  }
  .track:hover {
    border-color: var(--text);
  }
  .track-label {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 20px;
  }
  .track-text {
    color: var(--muted);
    font-size: 16px;
  }
  .track-eg {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
    color: var(--orange-glow);
  }
  /* Photo hero: photo fills the section, text sits on a dark scrim. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-photo {
    min-height: min(88svh, 820px);
    display: grid;
    align-items: end;
  }
  .hero-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(20, 16, 12, 0.8) 0%, rgba(20, 16, 12, 0.5) 55%, rgba(20, 16, 12, 0.15) 100%);
  }
  .hero-photo .hero-copy,
  .hero-photo .hero-lede,
  .hero-photo .hero-note {
    color: #fff;
  }
  .hero-photo .hero-kicker {
    color: #ffc79e;
  }
  .hero-photo .grad {
    background: none;
    color: #ffb27a;
  }
  .hero-photo .btn-ghost {
    border-color: #fff;
    color: #fff;
  }
  .hero-photo .track {
    background: rgba(255, 253, 249, 0.94);
  }

  /* ── Shared section heads ── */
  .head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 44px);
    max-width: 720px;
  }

  /* ── Results log ── */
  .results-section {
    background: var(--bg-2);
    border-block: 1px solid var(--border);
  }
  .results {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .results .head {
    margin-bottom: 0;
  }
  .log {
    list-style: none;
    padding: 0;
    border-top: 1.5px solid var(--text);
  }
  .log li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border-strong);
  }
  .log-date {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--orange-glow);
    padding-top: 3px;
  }
  .log a {
    color: var(--orange-glow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Quotes ── */
  .quotes-section {
    padding-top: 0;
  }
  .quotes {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
  }
  .quote {
    margin: 0;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .quote:nth-child(2) {
    transform: rotate(-0.6deg);
  }
  .quote:nth-child(3) {
    transform: rotate(0.5deg);
  }
  .quote blockquote {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.35;
  }
  .quote figcaption {
    font-size: 15px;
    color: var(--muted);
  }
  .quote .ph-pill {
    margin-left: 8px;
  }

  /* ── Student-led ── */
  .led {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .led-text {
    display: grid;
    gap: 14px;
  }
  .led-text > p {
    color: var(--muted);
  }
  .also {
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
    margin-top: 6px;
  }
  .also li::marker {
    color: var(--orange);
  }
  .led-photo {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    display: grid;
    place-content: center;
    text-align: center;
    gap: 4px;
    color: var(--faint);
    font-size: 15px;
    background:
      repeating-linear-gradient(-45deg, transparent 0 14px, rgba(26, 22, 17, 0.035) 14px 15px),
      var(--surface-2);
  }
  .led-photo span:first-child {
    font-weight: 700;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero-grid,
    .results,
    .led {
      grid-template-columns: 1fr;
    }
    .hero-grid {
      align-items: start;
    }
    .quotes {
      grid-template-columns: 1fr;
    }
    .quote:nth-child(n) {
      transform: none;
    }
  }
  @media (max-width: 520px) {
    .log li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
