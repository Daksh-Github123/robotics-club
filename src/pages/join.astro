---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MemberCard from '../components/MemberCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import SignupStatus from '../components/SignupStatus.astro';
import { faq } from '../data/faq';
import { sortMembers } from '../lib/meta';

const members = sortMembers(await getCollection('members')).filter((m) => m.data.contact && Object.values(m.data.contact).some(Boolean));
// Student leads first, then supervising faculty
const currentContacts = [
  ...members.filter((m) => m.data.status === 'current'),
  ...members.filter((m) => m.data.status === 'faculty'),
];
const alumniContacts = members.filter((m) => m.data.status === 'alumni');

const steps = [
  {
    title: 'Watch for BA sign-ups',
    text: "Tech for Change is part of the school's Beyond Academics (BA) program. Sign-ups open through the school.",
  },
  {
    title: 'Sign up fast',
    text: "Spots are first come, first served. Choose Tech for Change as soon as sign-ups open. You don't need any experience.",
  },
  {
    title: 'Check your venue',
    text: `This sprint we meet in ${site.meeting.where}. Come to the first BA period and start thinking about your project.`,
  },
];

const facts = [
  { label: 'Sign-ups', value: 'BA sign-ups, first come, first served' },
  { label: 'Where', value: site.meeting.where },
  { label: 'When', value: site.meeting.when },
  { label: 'Experience', value: 'None needed' },
];
---

<Base title="Join / FAQ" description="How to join Tech for Change, what to expect, and who to ask.">
  <PageHeader title="Come build with us." sub={site.applyInfo}>
    <SignupStatus />
  </PageHeader>

  <!-- ═════════ STEPS ═════════ -->
  <section class="section steps-section">
    <div class="container">
      <h2 class="h2">How to join</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step-n">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═════════ FACTS: the blue band ═════════ -->
  <div class="facts-band">
    <dl class="container facts">
      {
        facts.map((f) => (
          <div class="fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- ═════════ FAQ ═════════ -->
  <section class="section">
    <div class="container faq-section">
      <div class="faq-head">
        <SectionHeading title="Common questions" />
      </div>
      <div class="faq">
        {
          faq.map((item, i) => (
            <details class="qa" open={i === 0}>
              <summary>
                <span>{item.q}</span>
                <span class="qa-icon" aria-hidden="true">
                  <Icon name="plus" size={20} />
                </span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═════════ CONTACTS ═════════ -->
  <section class="section contacts-section" id="contacts">
    <div class="container">
      <SectionHeading
        title="Questions? Email us."
        sub="Reach out to the student lead or either of the supervising faculty."
      />
      {
        currentContacts.length > 0 && (
          <div class="contacts">
            {currentContacts.map((m) => (
              <MemberCard member={m} />
            ))}
          </div>
        )
      }
      {
        alumniContacts.length > 0 && (
          <>
            <h3 class="sub-h">Past members</h3>
            <div class="contacts">
              {alumniContacts.map((m) => (
                <MemberCard member={m} />
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</Base>

<style>
  /* ── Steps: a real sequence, so big blue numerals ── */
  .steps {
    list-style: none;
    padding: 0;
    margin-top: clamp(24px, 3vw, 36px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 40px);
  }
  .step {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 18px;
    border-top: 2px solid var(--navy);
  }
  .step-n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 64px;
    line-height: 0.85;
    color: var(--blue);
  }
  .step h3 {
    font-size: clamp(22px, 2.2vw, 26px);
  }
  .step p {
    color: var(--muted);
  }

  /* ── Facts band ── */
  .facts-band {
    background: var(--blue);
    color: #fff;
    padding-block: clamp(28px, 4vw, 40px);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-block: 0;
  }
  .fact {
    padding: 4px clamp(16px, 2vw, 28px);
    border-left: 1px solid rgba(255, 255, 255, 0.3);
  }
  .fact:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .fact dt {
    font-weight: 800;
    font-size: 20px;
    margin-bottom: 6px;
  }
  .fact dd {
    margin: 0;
    font-size: 16px;
    color: #dbe4f5;
  }

  /* ── FAQ ── */
  .faq-section {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .faq-head {
    position: sticky;
    top: 120px;
  }
  .faq {
    border-top: 2px solid var(--navy);
  }
  .qa {
    border-bottom: 1px solid var(--border-strong);
  }
  .qa summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.3;
    transition: color 0.2s;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary:hover {
    color: var(--blue);
  }
  .qa-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 4px;
    background: var(--bg-2);
    transition:
      transform 0.3s var(--ease-out),
      background 0.2s,
      color 0.2s;
  }
  .qa[open] .qa-icon {
    transform: rotate(45deg);
    background: var(--navy);
    color: #fff;
  }
  .qa p {
    color: var(--muted);
    padding: 0 56px 24px 0;
    max-width: 64ch;
  }

  /* ── Contacts ── */
  .contacts-section {
    background: var(--bg-2);
  }
  .contacts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-top: clamp(28px, 4vw, 40px);
  }
  .sub-h {
    margin-top: 56px;
    font-size: 22px;
  }
  .sub-h + .contacts {
    margin-top: 20px;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .step-n {
      font-size: 48px;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 22px 0;
    }
    .fact:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .faq-section {
      grid-template-columns: 1fr;
    }
    .faq-head {
      position: static;
    }
  }
  @media (max-width: 480px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .fact {
      border-left: 0;
      padding-left: 0;
    }
    .qa p {
      padding-right: 0;
    }
  }
</style>
