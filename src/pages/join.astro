---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MemberCard from '../components/MemberCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { faq } from '../data/faq';
import { sortMembers } from '../lib/meta';

const members = sortMembers(await getCollection('members')).filter((m) => m.data.contact && Object.values(m.data.contact).some(Boolean));
// Student leads first, then supervising faculty
const currentContacts = [
  ...members.filter((m) => m.data.status === 'current'),
  ...members.filter((m) => m.data.status === 'faculty'),
];
const alumniContacts = members.filter((m) => m.data.status === 'alumni');

const steps = [
  {
    icon: 'calendar',
    title: 'Watch for BA sign-ups',
    text: "Tech for Change is part of the school's Beyond Academics (BA) program. Sign-ups open through the school.",
  },
  {
    icon: 'bolt',
    title: 'Sign up fast',
    text: "Spots are first come, first served. Choose Tech for Change as soon as sign-ups open. You don't need any experience.",
  },
  {
    icon: 'pin',
    title: 'Check your venue',
    text: 'The school assigns the room. Watch for the announcement, then come to the first BA period and start thinking about your project.',
  },
];

const facts = [
  { icon: 'bolt', label: 'Sign-ups', value: 'BA sign-ups, first come, first served' },
  { icon: 'pin', label: 'Where', value: site.meeting.where },
  { icon: 'calendar', label: 'When', value: site.meeting.when },
  { icon: 'spark', label: 'Experience', value: 'None needed' },
];
---

<Base title="Join / FAQ" description="How to join Tech for Change, what to expect, and who to ask.">
  <PageHeader
    title='Come build <span class="grad">with us.</span>'
    sub={site.applyInfo}
  />

  <section class="container">
    <ol class="steps" data-reveal-group>
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step-k mono">STEP 0{i + 1}</span>
            <Icon name={s.icon} size={28} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>

    <dl class="facts" data-reveal-group>
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="mono">
              <Icon name={f.icon} size={15} /> {f.label}
            </dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section container faq-section">
    <div class="faq-head">
      <SectionHeading title='Common questions' />
    </div>
    <div class="faq" data-reveal-group>
      {
        faq.map((item, i) => (
          <details class="qa" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="qa-icon" aria-hidden="true">
                <Icon name="plus" size={20} />
              </span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section container" id="contacts">
    <SectionHeading
      title='Questions? Email us.'
      sub="Reach out to the student lead or either of the supervising faculty."
    />
    {
      currentContacts.length > 0 && (
        <div class="contacts" data-reveal-group>
          {currentContacts.map((m) => (
            <MemberCard member={m} />
          ))}
        </div>
      )
    }
    {
      alumniContacts.length > 0 && (
        <>
          <h3 class="sub-h mono">Past members</h3>
          <div class="contacts" data-reveal-group>
            {alumniContacts.map((m) => (
              <MemberCard member={m} />
            ))}
          </div>
        </>
      )
    }
  </section>
</Base>

<style>
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .step {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: clamp(26px, 3vw, 36px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
  }
  .step :global(svg) {
    color: var(--orange-glow);
  }
  .step-k {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--faint);
  }
  .step h3 {
    font-size: clamp(22px, 2.2vw, 28px);
  }
  .step p {
    color: var(--muted);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 16px 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }
  .fact {
    padding: 22px 24px;
    border-right: 1px solid var(--border);
  }
  .fact:last-child {
    border-right: 0;
  }
  .fact dt {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--orange-glow);
    margin-bottom: 8px;
  }
  .fact dd {
    margin: 0;
    font-size: 15.5px;
  }
  .faq-section {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .faq-head {
    position: sticky;
    top: 120px;
  }
  .faq {
    border-top: 1px solid var(--border);
  }
  .qa {
    border-bottom: 1px solid var(--border);
  }
  .qa summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 24px 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.3;
    transition: color 0.2s;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary:hover {
    color: var(--orange-glow);
  }
  .qa-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    transition:
      transform 0.4s var(--ease-out),
      background 0.3s,
      color 0.3s;
  }
  .qa[open] .qa-icon {
    transform: rotate(45deg);
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
  }
  .qa p {
    color: var(--muted);
    padding: 0 56px 26px 0;
    max-width: 64ch;
  }
  .contacts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin-top: clamp(32px, 4vw, 48px);
  }
  .sub-h {
    margin-top: 56px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .sub-h + .contacts {
    margin-top: 20px;
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .fact:nth-child(2) {
      border-right: 0;
    }
    .fact:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }
    .faq-section {
      grid-template-columns: 1fr;
    }
    .faq-head {
      position: static;
    }
  }
  @media (max-width: 480px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .fact {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .qa p {
      padding-right: 0;
    }
  }
/* Plain numbered list (no cards, no icons) */
  .step {
    background: none;
    border: 0;
    border-top: 1.5px solid var(--text);
    border-radius: 0;
    padding: 16px 0 0;
    box-shadow: none;
  }
  .step > :global(svg) {
    display: none;
  }
</style>
