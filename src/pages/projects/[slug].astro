---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, sortProjects, statusLabel, yearLabel, mediaIcon } from '../../lib/meta';

export async function getStaticPaths() {
  const projects = sortProjects(await getCollection('projects'));
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---

<Base title={d.title} description={d.tagline}>
  <article>
    <header class="container pd-head">
      <a href="/projects/" class="pd-back"><Icon name="arrowLeft" size={16} /> All projects</a>
      <div class="pd-meta">
        <span class={`stream stream-${d.stream}`}>{d.stream === 'software' ? 'Software' : 'Robotics'}</span>
        <span class={`chip status status-${d.status}`}>{statusLabel[d.status]}</span>
        <span class="chip">{yearLabel(d.academicYear)}</span>
        <span class="chip"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></span>
        {d.placeholder && <span class="ph-pill">placeholder</span>}
      </div>
      <h1 class="display pd-title">{d.title}</h1>
      <p class="lede">{d.tagline}</p>
    </header>

    <div class="container">
      <div class={`pd-media pd-media-${d.stream}`}>
        <ProjectMedia project={project} eager />
      </div>
      {
        d.media.length > 0 && (
          <ul class="pd-mlinks" aria-label="More photos and videos">
            {d.media.map((m) => (
              <li>
                <a href={m.url} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">
                  <Icon name={mediaIcon[m.type] ?? 'external'} size={16} />
                  {m.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="container pd-grid">
      <aside class="pd-side">
        {
          d.team.length > 0 && (
            <section>
              <h2 class="pd-label">
                <Icon name="users" size={16} /> Team
              </h2>
              <ul class="pd-team">
                {d.team.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            </section>
          )
        }
        {
          d.tech.length > 0 && (
            <section>
              <h2 class="pd-label">
                <Icon name="cpu" size={16} /> Built with
              </h2>
              <div class="pd-tags">
                {d.tech.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </section>
          )
        }
        {
          d.categories.length > 0 && (
            <section>
              <h2 class="pd-label">
                <Icon name="box" size={16} /> Category
              </h2>
              <div class="pd-tags">
                {d.categories.map((c) => (
                  <span class="tag">{c}</span>
                ))}
              </div>
            </section>
          )
        }
        {
          d.links.length > 0 && (
            <section>
              <h2 class="pd-label">
                <Icon name="external" size={16} /> Links
              </h2>
              <ul class="pd-links">
                {d.links.map((l) => (
                  <li>
                    <a href={l.url} target="_blank" rel="noopener">
                      {l.label} <Icon name="external" size={14} />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    {
      d.gallery.length > 0 && (
        <section class="container pd-gallery" aria-label="Gallery">
          {d.gallery.map((src, i) => (
            <img src={src} alt={`${d.title}, photo ${i + 1}`} loading="lazy" decoding="async" />
          ))}
        </section>
      )
    }

    <nav class="container pd-nav" aria-label="More projects">
      <a href={`/projects/${prev.id}/`} class="pd-nav-link">
        <span class="pd-nav-k"><Icon name="arrowLeft" size={14} /> Previous</span>
        <span class="pd-nav-t">{prev.data.title}</span>
      </a>
      <a href={`/projects/${next.id}/`} class="pd-nav-link pd-nav-next">
        <span class="pd-nav-k">Next <Icon name="arrow" size={14} /></span>
        <span class="pd-nav-t">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .pd-head {
    padding-top: clamp(120px, 15vw, 180px);
    padding-bottom: clamp(36px, 5vw, 56px);
  }
  .pd-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 28px;
    transition: color 0.2s;
  }
  .pd-back:hover {
    color: var(--blue);
  }
  .pd-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .pd-title {
    font-size: clamp(32px, 5vw, 68px);
    margin: 22px 0 20px;
  }
  .pd-media {
    position: relative;
    aspect-ratio: 16 / 8;
    border-radius: 4px;
    overflow: hidden;
    border-bottom: 10px solid var(--orange);
  }
  .pd-media-robotics {
    border-bottom-color: var(--blue);
  }
  .pd-media :global(.pm-video) {
    opacity: 1;
  }
  .pd-mlinks {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .pd-mlinks :global(svg) {
    color: var(--blue);
  }
  .pd-mlinks a:hover :global(svg) {
    transform: none;
  }
  .pd-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: clamp(32px, 6vw, 88px);
    padding-block: clamp(48px, 7vw, 96px);
  }
  .pd-side {
    display: grid;
    gap: 32px;
    align-content: start;
    position: sticky;
    top: 110px;
  }
  .pd-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0;
    color: var(--text);
    margin-bottom: 12px;
  }
  .pd-label :global(svg) {
    color: var(--blue);
  }
  .pd-team,
  .pd-links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .pd-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .pd-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pd-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .pd-gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
  }
  .pd-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-bottom: clamp(80px, 10vw, 130px);
  }
  .pd-nav-link {
    display: grid;
    gap: 10px;
    padding: 26px 28px;
    border-radius: 4px;
    background: var(--bg-2);
    border-top: 6px solid var(--navy);
    overflow: hidden;
    transition: background 0.2s;
  }
  .pd-nav-link:hover {
    background: var(--surface-2);
  }
  .pd-nav-next {
    text-align: right;
  }
  .pd-nav-k {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
    color: var(--muted);
  }
  .pd-nav-next .pd-nav-k {
    justify-content: flex-end;
  }
  .pd-nav-t {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(19px, 2vw, 26px);
  }
  @media (max-width: 860px) {
    .pd-grid {
      grid-template-columns: 1fr;
    }
    .pd-side {
      position: static;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    .pd-media {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 560px) {
    .pd-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
