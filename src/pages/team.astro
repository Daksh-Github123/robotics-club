---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MemberCard from '../components/MemberCard.astro';
import Icon from '../components/Icon.astro';
import { sortMembers } from '../lib/meta';

const all = sortMembers(await getCollection('members'));
const founders = all.filter((m) => m.data.founder && m.data.status === 'current');
const current = all.filter((m) => m.data.status === 'current' && !m.data.founder);
const alumni = all
  .filter((m) => m.data.status === 'alumni')
  .sort((a, b) => (b.data.gradYear ?? 0) - (a.data.gradYear ?? 0) || a.data.order - b.data.order);
const alumniFounders = alumni.filter((m) => m.data.founder);
const faculty = all.filter((m) => m.data.status === 'faculty');
---

<Base title="Team" description="The students who run Robotics Club at Inventure Academy, its supervising faculty, and its alumni.">
  <PageHeader
    title='The people behind <span class="grad">the bots.</span>'
    sub="Robotics Club is fully student-led. Students run it and teach it, with supervision from faculty."
  />

  <section class="container team">
    {
      founders.length > 0 && (
        <div class="founders" data-reveal>
          {founders.map((m) => (
            <MemberCard member={m} big />
          ))}
        </div>
      )
    }

    {
      current.length > 0 && (
        <div class="block">
          <SectionHeading title="Running the club" />
          <div class="grid" data-reveal-group>
            {current.map((m) => (
              <MemberCard member={m} />
            ))}
          </div>
        </div>
      )
    }

    {
      faculty.length > 0 && (
        <div class="block">
          <SectionHeading
            title='Supervising faculty'
            sub="The club is run by students. Faculty supervise it and oversee anything that needs a teacher, like sawing, drilling and soldering."
          />
          <div class="grid" data-reveal-group>
            {faculty.map((m) => (
              <MemberCard member={m} />
            ))}
          </div>
        </div>
      )
    }

    <div class="block">
      <SectionHeading
        title='Past members'
        sub="Past members who helped build the club. Many are happy to answer questions about competitions and college."
      />
      {
        alumni.length > 0 ? (
          <div class="grid" data-reveal-group>
            {[...alumniFounders, ...alumni.filter((m) => !m.data.founder)].map((m) => (
              <MemberCard member={m} />
            ))}
          </div>
        ) : (
          <p class="muted empty">No alumni yet. Our first class graduates soon.</p>
        )
      }
    </div>

    <a href="/join/" class="join-strip" data-reveal>
      <span>
        <strong>Want your face on this page?</strong>
      </span>
      <span class="btn btn-primary">Join the club <Icon name="arrow" size={18} /></span>
    </a>
  </section>
</Base>

<style>
  .team {
    padding-bottom: clamp(80px, 10vw, 140px);
    display: grid;
    gap: clamp(72px, 9vw, 120px);
  }
  .founders {
    display: grid;
    gap: 16px;
  }
  .block {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .empty {
    font-size: 17px;
  }
  .join-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
  }
  .join-strip > span:first-child {
    display: grid;
    gap: 8px;
  }
  .join-strip strong {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.1;
  }
</style>
