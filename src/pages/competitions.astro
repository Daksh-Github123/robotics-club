---
/**
 * Competitions page. The club is about building projects; this page explains
 * how it connects to competitions:
 *  - "club" competitions (independent ones) are done with the club.
 *  - "school-team" competitions are run by other teachers; the club recommends members.
 * Set `kind` in each file in src/content/competitions/.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';

const comps = (await getCollection('competitions')).sort((a, b) => a.data.order - b.data.order);

const groups = [
  {
    kind: 'club',
    title: 'Independent competitions',
    sub: 'Independent competitions are done with the club. Members plan, build and prepare their entries together.',
  },
  {
    kind: 'school-team',
    title: 'School teams, run by other teachers',
    sub: "The school's competition teams are managed by other teachers, and their details are shared separately. Club members get recommendations to join, and each team schedules its own after-school practices.",
  },
] as const;

const pathway = [
  { icon: 'users', title: 'Join the club', text: "Sign up through the school's Beyond Academics (BA) sign-ups and build projects in BA periods." },
  { icon: 'wrench', title: 'Build your skills', text: 'Every project teaches you sensors, wiring and code, the same skills competitions test.' },
  { icon: 'trophy', title: 'Get recommended', text: "The club gives members recommendations so they can join the school's competition teams straight away." },
];

const help = [
  { icon: 'lightbulb', title: 'Picking a competition', text: 'Figure out which events fit your interests and skill level.' },
  { icon: 'users', title: 'Building a team', text: 'Find teammates in the club with the skills you are missing.' },
  { icon: 'code', title: 'Application & prep', text: 'Feedback on applications, pitch videos and practice runs from people who have done it.' },
  { icon: 'box', title: 'Parts & workspace', text: 'Build and test your entry during club time.' },
];
---

<Base title="Competitions" description="How Robotics Club connects to competitions: independent competitions with the club, and recommendations for the school teams.">
  <PageHeader
    title='Competitions <span class="grad">&amp; the club</span>'
    sub="Robotics Club is about building projects. Independent competitions are done with the club, and the school's competition teams are run by other teachers."
  />

  <section class="container">
    <ol class="path" data-reveal-group>
      {
        pathway.map((p, i) => (
          <li class="path-step">
            <span class="path-k mono">0{i + 1}</span>
            <span class="path-icon">
              <Icon name={p.icon} size={28} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    groups.map((g) => {
      const list = comps.filter((c) => c.data.kind === g.kind);
      return (
        <section class="section container">
          <SectionHeading title={g.title} sub={g.sub} />
          <div class="comps" data-reveal-group>
            {list.map((c) => (
              <article class="comp">
                <div class="comp-head">
                  <span class="chip">{c.data.level}</span>
                  {c.data.placeholder && <span class="ph-pill">placeholder</span>}
                </div>
                <h3>{c.data.name}</h3>
                <p class="comp-desc">{c.data.description}</p>
                <div class="comp-results">
                  <p class="mono comp-label">
                    <Icon name="trophy" size={14} /> {g.kind === 'school-team' ? 'School results' : 'Results'}
                  </p>
                  {c.data.results.length > 0 ? (
                    <ul>
                      {c.data.results.map((r) => (
                        <li>
                          <span class="mono">{r.year}</span> {r.result}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="muted comp-empty">No results yet.</p>
                  )}
                </div>
                {c.data.website && (
                  <a class="comp-link" href={c.data.website} target="_blank" rel="noopener">
                    Official site <Icon name="external" size={14} />
                  </a>
                )}
              </article>
            ))}
          </div>
          {g.kind === 'club' && (
            <>
              <div class="help" data-reveal-group>
                {help.map((h) => (
                  <div class="help-item">
                    <Icon name={h.icon} size={24} />
                    <h3>{h.title}</h3>
                    <p>{h.text}</p>
                  </div>
                ))}
              </div>
              <a href="/join/#contacts" class="btn btn-primary help-cta">
                Ask a member <Icon name="arrow" size={18} />
              </a>
            </>
          )}
        </section>
      );
    })
  }
</Base>

<style>
  .path {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    counter-reset: step;
  }
  .path-step {
    position: relative;
    display: grid;
    gap: 14px;
    align-content: start;
    padding: clamp(26px, 3vw, 36px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
  }
  .path-step:not(:last-child)::after {
    display: none;
    content: '→';
    position: absolute;
    right: 22px;
    top: 26px;
    font-size: 26px;
    color: var(--orange);
  }
  .path-step:last-child {
    border-color: color-mix(in srgb, var(--orange) 50%, var(--border));
    box-shadow: 0 12px 28px -18px rgba(26, 22, 17, 0.35);
  }
  .path-k {
    font-size: 13px;
    color: var(--faint);
  }
  .path-icon {
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    color: var(--orange-glow);
    background: var(--orange-soft);
    border: 1px solid var(--orange);
  }
  .path-step h3 {
    font-size: clamp(22px, 2.2vw, 28px);
  }
  .path-step p {
    color: var(--muted);
  }
  .comps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
    margin-top: clamp(36px, 5vw, 56px);
  }
  .comp {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      border-color 0.3s,
      transform 0.35s var(--ease-out);
  }
  .comp:hover {
    border-color: color-mix(in srgb, var(--blue) 55%, var(--border));
  }
  .comp-head {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .comp h3 {
    font-size: 26px;
  }
  .comp-desc {
    color: var(--muted);
    font-size: 15.5px;
  }
  .comp-results {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .comp-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 8px;
  }
  .comp-results ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 15px;
  }
  .comp-results .mono {
    color: var(--orange-glow);
    margin-right: 8px;
  }
  .comp-empty {
    font-size: 14px;
  }
  .comp-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--blue-glow);
  }
  .help {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin-top: clamp(36px, 5vw, 56px);
  }
  .help-item {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 22px;
    border-top: 1px solid var(--border-strong);
  }
  .help-item :global(svg) {
    color: var(--blue-glow);
  }
  .help-item h3 {
    font-size: 20px;
  }
  .help-item p {
    color: var(--muted);
    font-size: 15px;
  }
  .help-cta {
    margin-top: 48px;
  }
  @media (max-width: 900px) {
    .path {
      grid-template-columns: 1fr;
    }
    .path-step:not(:last-child)::after {
      content: '↓';
    }
    .help {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .help {
      grid-template-columns: 1fr;
    }
  }
/* Plain numbered list (no cards, no icons) */
  .path-step, .path-step:last-child {
    background: none;
    border: 0;
    border-top: 1.5px solid var(--text);
    border-radius: 0;
    padding: 16px 0 0;
    box-shadow: none;
  }
  .path-icon {
    display: none;
  }
</style>
