---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';

const comps = (await getCollection('competitions')).sort((a, b) => a.data.order - b.data.order);

const pathway = [
  { icon: 'users', title: 'Join the club', text: 'Sign up through the school system and come to meetings.' },
  { icon: 'wrench', title: 'Build in sprints', text: 'Work on real projects and pick up the skills competitions test.' },
  { icon: 'trophy', title: 'Get on a school team', text: "Club members get a direct route onto the school's competition teams." },
];

const help = [
  { icon: 'lightbulb', title: 'Picking a competition', text: 'Figure out which events fit your interests and skill level.' },
  { icon: 'users', title: 'Building a team', text: 'Find teammates in the club with the skills you are missing.' },
  { icon: 'code', title: 'Application & prep', text: 'Feedback on applications, design docs and practice runs from people who have done it.' },
  { icon: 'box', title: 'Parts & workspace', text: 'Access to the club workspace and spare parts for prototyping.' },
];
---

<Base title="Competitions" description="How club members get onto the school's robotics competition teams, and get help entering others.">
  <PageHeader
    eyebrow="Competitions"
    title='Your pathway onto <span class="grad">school teams.</span>'
    sub="The club is the way onto the school's robotics competition teams, and a launchpad for entering competitions on your own."
  />

  <section class="container">
    <ol class="path" data-reveal-group>
      {
        pathway.map((p, i) => (
          <li class="path-step" data-glow>
            <span class="path-k mono">0{i + 1}</span>
            <span class="path-icon">
              <Icon name={p.icon} size={28} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Where we compete" title='Competitions <span class="grad">&amp; results</span>' />
    <div class="comps" data-reveal-group>
      {
        comps.map((c) => (
          <article class="comp" data-tilt>
            <div class="comp-head">
              <span class="chip">{c.data.level}</span>
              {c.data.placeholder && <span class="ph-pill">placeholder</span>}
            </div>
            <h3>{c.data.name}</h3>
            <p class="comp-desc">{c.data.description}</p>
            <div class="comp-results">
              <p class="mono comp-label">
                <Icon name="trophy" size={14} /> Results
              </p>
              {c.data.results.length > 0 ? (
                <ul>
                  {c.data.results.map((r) => (
                    <li>
                      <span class="mono">{r.year}</span> {r.result}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="muted comp-empty">No results yet.</p>
              )}
            </div>
            {c.data.website && (
              <a class="comp-link" href={c.data.website} target="_blank" rel="noopener">
                Official site <Icon name="external" size={14} />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section container help-section">
    <SectionHeading
      eyebrow="Other competitions"
      title='We help you enter <span class="grad">other competitions</span> too.'
      sub="If there's a competition the school doesn't send a team to, the club is still your support crew."
    />
    <div class="help" data-reveal-group>
      {
        help.map((h) => (
          <div class="help-item">
            <Icon name={h.icon} size={24} />
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </div>
        ))
      }
    </div>
    <a href="/join/#contacts" class="btn btn-primary help-cta" data-magnetic>Ask a member <Icon name="arrow" size={18} /></a>
  </section>
</Base>

<style>
  .path {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    counter-reset: step;
  }
  .path-step {
    position: relative;
    display: grid;
    gap: 14px;
    align-content: start;
    padding: clamp(26px, 3vw, 36px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
  }
  .path-step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: 22px;
    top: 26px;
    font-size: 26px;
    color: var(--orange);
  }
  .path-step:last-child {
    border-color: color-mix(in srgb, var(--orange) 50%, var(--border));
    box-shadow: 0 30px 80px -40px rgba(255, 122, 26, 0.7);
  }
  .path-k {
    font-size: 13px;
    color: var(--faint);
  }
  .path-icon {
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    color: var(--orange-glow);
    background: rgba(255, 122, 26, 0.12);
    border: 1px solid rgba(255, 122, 26, 0.35);
  }
  .path-step h3 {
    font-size: clamp(22px, 2.2vw, 28px);
  }
  .path-step p {
    color: var(--muted);
  }
  .comps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
    margin-top: clamp(36px, 5vw, 56px);
  }
  .comp {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      border-color 0.3s,
      transform 0.35s var(--ease-out);
  }
  .comp:hover {
    border-color: color-mix(in srgb, var(--blue) 55%, var(--border));
  }
  .comp-head {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .comp h3 {
    font-size: 26px;
  }
  .comp-desc {
    color: var(--muted);
    font-size: 15.5px;
  }
  .comp-results {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .comp-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 8px;
  }
  .comp-results ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 15px;
  }
  .comp-results .mono {
    color: var(--orange-glow);
    margin-right: 8px;
  }
  .comp-empty {
    font-size: 14px;
  }
  .comp-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--blue-glow);
  }
  .help {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin-top: clamp(36px, 5vw, 56px);
  }
  .help-item {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 22px;
    border-top: 1px solid var(--border-strong);
  }
  .help-item :global(svg) {
    color: var(--blue-glow);
  }
  .help-item h3 {
    font-size: 20px;
  }
  .help-item p {
    color: var(--muted);
    font-size: 15px;
  }
  .help-cta {
    margin-top: 48px;
  }
  @media (max-width: 900px) {
    .path {
      grid-template-columns: 1fr;
    }
    .path-step:not(:last-child)::after {
      content: '↓';
    }
    .help {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .help {
      grid-template-columns: 1fr;
    }
  }
</style>
