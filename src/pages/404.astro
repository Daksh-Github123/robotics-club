---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="nf container">
    <h1 class="display">This page took a wrong turn.</h1>
    <p class="lede">The page you're looking for doesn't exist or has moved.</p>
    <div class="nf-actions">
      <a href="/" class="btn btn-primary">Back to base</a>
      <a href="/projects/" class="btn btn-ghost">See projects</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 26px;
    padding-top: 140px;
    padding-bottom: 80px;
  }
  .nf .display {
    max-width: 14ch;
    padding-bottom: 18px;
    border-bottom: 10px solid var(--blue);
  }
  .nf-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
