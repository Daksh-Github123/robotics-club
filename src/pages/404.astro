---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" noindex>
  <section class="nf container">
    <h1 class="display">This page <span class="grad">took a wrong turn.</span></h1>
    <p class="lede">The page you're looking for doesn't exist or has moved.</p>
    <div class="nf-actions">
      <a href="/" class="btn btn-primary">Back to base <Icon name="arrow" size={18} /></a>
      <a href="/projects/" class="btn btn-ghost">See projects</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    gap: 26px;
    padding-top: 140px;
    padding-bottom: 80px;
  }
  .nf-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
