---
/**
 * "Why join" page: the link to share around school.
 * Opens with a big scroll-driven intro announcing that Tech for Change now does
 * robotics as well as websites, then switches to the site's calm layout.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import SprintSteps from '../components/SprintSteps.astro';
import JoinBox from '../components/JoinBox.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';

const projects = await getCollection('projects');
const pick = ['pathfinder', 'smart-dustbin', 'asl-translator-glove'];
const showcase = pick.map((id) => projects.find((p) => p.id === id)).filter((p) => p !== undefined);

const word = 'Robotics';

const tracks = [
  {
    name: 'Software',
    lead: 'Build websites and tools that make school run better.',
    points: [
      'Turn paper systems into something searchable and easy to use, like the Pathfinder behaviour charts.',
      'Design it, build it, then get real people at school using it.',
      'Club leads help with the code when you get stuck.',
    ],
  },
  {
    name: 'Robotics',
    lead: 'Build machines that work in the real world.',
    points: [
      'Wire up sensors, motors and microcontrollers like Arduino and ESP32.',
      "Make things like a bin that opens itself or a glove that reads sign language.",
      'You learn exactly the electronics your project needs, nothing more.',
    ],
  },
];

const further = [
  {
    title: 'Get the school using it',
    text: 'Projects are built for real problems at school, so the next step is real users.',
    eg: 'The Pathfinder team is planning posters and video ads so every teacher knows it exists.',
  },
  {
    title: 'Enter a competition',
    text: 'Independent competitions, like the Blue Ocean Entrepreneurship Competition, are done with the club. For the school competition teams, run by other teachers, club members get recommendations to join.',
  },
  {
    title: 'Write a research paper',
    text: 'Your project page already records the problem, how it works and what you learned: a head start on a paper.',
  },
  {
    title: 'Take it outside school',
    text: 'The project is yours. Keep building it, or start your own organisation around it.',
  },
];
---

<Base
  title="Why join"
  description="Tech for Change isn't just websites any more. Build robots and software that your school actually uses, in a club run by students."
>
  <!-- ═════════ BIG SCROLLING INTRO ═════════ -->
  <section class="intro" data-intro aria-label="Tech for Change now does robotics">
    <div class="stage">
      <p class="frame f1" data-f1>
        <span class="small">Tech for Change used to be only</span>
        <span class="big">For Websites</span>
      </p>
      <p class="frame f2" data-f2>
        <span class="big">Now we build</span>
        <span class="big accent">robots too.</span>
      </p>
      <h1 class="frame f3" data-f3>
        <span class="small" data-f3-fade>New to Tech for Change</span>
        <span class="huge" aria-label={word}>
          {[...word].map((ch) => <span class="ch" aria-hidden="true">{ch}</span>)}
        </span>
        <span class="sub" data-f3-fade>Websites and robots, built by students, used by the school.</span>
      </h1>
      <span class="cue" data-cue aria-hidden="true">Scroll <Icon name="arrowDown" size={16} /></span>
    </div>
  </section>

  <!-- ═════════ WHAT YOU'LL DO ═════════ -->
  <section class="section first">
    <div class="container">
      <div class="head">
        <h2 class="h2">Pick your stream</h2>
        <p class="lede">
          When you join, you pick one stream: software or robotics. Either way, you find a problem worth solving, build
          the fix and show it to the whole school.
        </p>
      </div>
      <div class="tracks">
        {
          tracks.map((t) => (
            <article class={`track track-${t.name.toLowerCase()}`}>
              <h3>{t.name}</h3>
              <p class="track-lead">{t.lead}</p>
              <ul>
                {t.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═════════ PROJECTS ═════════ -->
  <section class="section alt">
    <div class="container">
      <div class="head">
        <h2 class="h2">What members are building</h2>
        <p class="lede">A website the school's teachers can use, a bin you never have to touch, a glove that reads sign language. More are in progress.</p>
      </div>
      <HorizontalGallery projects={showcase} total={projects.length} />
    </div>
  </section>

  <!-- ═════════ HOW A SPRINT WORKS ═════════ -->
  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="h2">How a project happens</h2>
        <p class="lede">No experience needed. Each step shows what a real team did.</p>
      </div>
      <SprintSteps skipLast />
    </div>
  </section>

  <!-- ═════════ TAKE IT FURTHER ═════════ -->
  <section class="section alt">
    <div class="container">
      <div class="head">
        <h2 class="h2">After the showcase, it's yours</h2>
        <p class="lede">The BA Showcase isn't the finish line. Here's where members take their projects next.</p>
      </div>
      <ol class="further">
        {
          further.map((f) => (
            <li>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
              {f.eg && <p class="eg">{f.eg}</p>}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═════════ STUDENT-LED ═════════ -->
  <section class="section">
    <div class="container led">
      <h2 class="h2">Run by students, start to finish</h2>
      <div class="led-text">
        <p>
          {site.name} is one of the only student-led clubs at {site.school}. Students run the sessions, teach each other
          and decide what to build. Faculty supervise.
        </p>
        <ul>
          <li>You'll work with students from other grades, including seniors you might not otherwise meet.</li>
          <li>You can step up: mentor newer members, teach a topic, or run the club when the current leads graduate.</li>
          <li>Every project gets its own page on this site, which you can link in college and university applications.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═════════ WHAT YOU NEED ═════════ -->
  <section class="section alt">
    <div class="container needs">
      <div class="head">
        <h2 class="h2">What you need</h2>
        <p class="lede">Only two things, but both are non-negotiable.</p>
      </div>
      <ol class="need-list">
        <li>
          <span class="n">1</span>
          <div>
            <h3>A working laptop, every class</h3>
            <p>Every project, software or robotics, is planned, coded and tested on a laptop. Without one, you can't work on yours.</p>
          </div>
        </li>
        <li>
          <span class="n">2</span>
          <div>
            <h3>A willingness to learn</h3>
            <p>
              BA periods are for building your project. Members who spend them wasting time end the sprint with nothing to show at
              the BA Showcase. Come ready to work and you'll have something real by the end.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═════════ JOIN ═════════ -->
  <JoinBox title={`Join ${site.name}`} />
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reducedMotion } from '../scripts/motion';
  gsap.registerPlugin(ScrollTrigger);

  const intro = document.querySelector<HTMLElement>('[data-intro]');
  if (intro && !reducedMotion) {
    // Without this class the frames simply stack (no-JS / reduced motion).
    intro.classList.add('is-animated');
    const f1 = intro.querySelector('[data-f1]');
    const f2 = intro.querySelector('[data-f2]');
    const chars = intro.querySelectorAll('.f3 .ch');
    const f3fade = intro.querySelectorAll('[data-f3-fade]');
    const cue = intro.querySelector('[data-cue]');

    gsap.set([f2], { autoAlpha: 0, y: 80 });
    gsap.set(chars, { yPercent: 110, autoAlpha: 0 });
    gsap.set(f3fade, { autoAlpha: 0, y: 24 });

    // First frame rises in on load
    gsap.from(f1!.children, { y: 60, autoAlpha: 0, duration: 1.1, stagger: 0.12, ease: 'power3.out' });

    // Then scrolling drives the rest
    gsap
      .timeline({
        defaults: { ease: 'power2.inOut' },
        scrollTrigger: { trigger: intro, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
      })
      .to(cue, { autoAlpha: 0, duration: 0.3 }, 0)
      .to(f1, { autoAlpha: 0, y: -80, scale: 1.06, duration: 1 }, 0.1)
      .to(f2, { autoAlpha: 1, y: 0, duration: 1 }, 0.5)
      .to({}, { duration: 0.6 })
      .to(f2, { autoAlpha: 0, y: -80, duration: 1 })
      .to(chars, { yPercent: 0, autoAlpha: 1, duration: 1, stagger: 0.07, ease: 'power3.out' }, '<0.3')
      .to(f3fade, { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.15 }, '-=0.4')
      .to({}, { duration: 0.8 });
  }
</script>

<style>
  /* ── Intro ── */
  .intro {
    position: relative;
    background: var(--bg);
  }
  .stage {
    display: grid;
    gap: clamp(48px, 10vh, 96px);
    padding: clamp(120px, 16vw, 180px) var(--gutter) 64px;
    text-align: center;
  }
  .frame {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .small {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(18px, 2vw, 26px);
    color: var(--muted);
  }
  .big {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(44px, 8vw, 120px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  /* Robotics is always classroom blue on this site */
  .accent {
    color: var(--blue);
  }
  .huge {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(76px, 18vw, 280px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--orange);
  }
  .ch {
    display: inline-block;
  }
  .sub {
    font-size: clamp(18px, 1.8vw, 24px);
    color: var(--muted);
    max-width: 34ch;
    margin-top: 12px;
  }
  .cue {
    display: none;
  }

  /* Animated mode (added by the script): a tall section with a sticky stage */
  .intro.is-animated {
    height: 380vh;
  }
  .is-animated .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    padding: 0 var(--gutter);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .is-animated .frame {
    grid-area: 1 / 1;
  }
  .is-animated .cue {
    position: absolute;
    bottom: 28px;
    left: 50%;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    color: var(--muted);
  }

  /* ── Calm part ── */
  .first {
    border-top: 10px solid var(--blue);
  }
  .alt {
    background: var(--bg-2);
  }
  .head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 44px);
    max-width: 720px;
  }
  /* Stream panels: uniform orange for software, classroom blue for robotics */
  .tracks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .track {
    padding: clamp(24px, 3vw, 36px);
    border-radius: 4px;
    background: var(--orange);
    color: var(--navy);
  }
  .track-robotics {
    background: var(--blue);
    color: #fff;
  }
  .track h3 {
    font-size: clamp(28px, 3vw, 36px);
  }
  .track-lead {
    margin: 8px 0 16px;
    font-weight: 700;
    font-size: 19px;
  }
  .track ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .track li {
    position: relative;
    padding-left: 22px;
  }
  .track li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 9px;
    height: 9px;
    background: currentColor;
  }
  .track-robotics ul {
    color: #dbe4f5;
  }
  .further {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 clamp(24px, 4vw, 56px);
  }
  .further li {
    padding: 22px 0;
    border-top: 2px solid var(--navy);
  }
  .further h3 {
    font-size: 23px;
    margin-bottom: 6px;
  }
  .further p {
    color: var(--muted);
  }
  .further .eg {
    margin-top: 10px;
    font-size: 16px;
    padding: 12px 16px;
    background: var(--surface);
    border-radius: 3px;
  }
  .led {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }
  .led-text {
    display: grid;
    gap: 14px;
    color: var(--muted);
  }
  .led-text ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .led-text li {
    position: relative;
    padding-left: 22px;
  }
  .led-text li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 9px;
    height: 9px;
    background: var(--blue);
  }
  .needs {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }
  .needs .head {
    margin-bottom: 0;
  }
  .need-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .need-list li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding: 22px 24px;
    background: var(--surface);
    border-left: 6px solid var(--orange);
    border-radius: 4px;
  }
  .need-list .n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 52px;
    line-height: 0.85;
    color: var(--blue);
  }
  .need-list h3 {
    font-size: 22px;
    margin-bottom: 6px;
  }
  .need-list p {
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .needs,
    .tracks,
    .further,
    .led {
      grid-template-columns: 1fr;
    }
  }
</style>
